-- Port of AmmLean.swap_output_identity (AmmLean/Invariant.lean lines 56-60).
-- tot has no fields, no division and no tactics, so the field operations
-- and the exact Mathlib lemmas of the Lean proof are hypotheses.
def swapOutputIdentity :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fzero : F) -> (0 flt : F -> F -> Type 0) ->
  (0 addPos : (a : F) -> (b : F) -> (0 ha : flt fzero a) -> (0 hb : flt fzero b) -> flt fzero (fadd a b)) ->
  (0 neOfGt : (a : F) -> (0 h : flt fzero a) -> (0 e : Eq F a fzero) -> Empty) ->
  (0 mulSub : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul a (fsub b c)) (fsub (fmul a b) (fmul a c))) ->
  (0 mulDivAssoc : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul a (fdiv b c)) (fdiv (fmul a b) c)) ->
  (0 mulDivCancelLeft : (a : F) -> (b : F) -> (0 hne : (0 e : Eq F a fzero) -> Empty) -> Eq F (fdiv (fmul a b) a) b) ->
  (0 addMul : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul (fadd a b) c) (fadd (fmul a c) (fmul b c))) ->
  (0 mulComm : (a : F) -> (b : F) -> Eq F (fmul a b) (fmul b a)) ->
  (0 addSubCancelRight : (a : F) -> (b : F) -> Eq F (fsub (fadd a b) b) a) ->
  (x : F) -> (y : F) -> (dx : F) -> (0 hx : flt fzero x) -> (0 hdx : flt fzero dx) ->
  Eq F (fmul (fadd x dx) (fsub y (fdiv (fmul y dx) (fadd x dx)))) (fmul x y) :=
  fun F fadd fmul fsub fdiv fzero flt addPos neOfGt mulSub mulDivAssoc
      mulDivCancelLeft addMul mulComm addSubCancelRight x y dx hx hdx =>
    trans0 F
      (fmul (fadd x dx) (fsub y (fdiv (fmul y dx) (fadd x dx))))
      (fsub (fmul (fadd x dx) y) (fmul (fadd x dx) (fdiv (fmul y dx) (fadd x dx))))
      (fmul x y)
      (mulSub (fadd x dx) y (fdiv (fmul y dx) (fadd x dx)))
    (trans0 F
      (fsub (fmul (fadd x dx) y) (fmul (fadd x dx) (fdiv (fmul y dx) (fadd x dx))))
      (fsub (fmul (fadd x dx) y) (fdiv (fmul (fadd x dx) (fmul y dx)) (fadd x dx)))
      (fmul x y)
      (cong0 F F
        (fmul (fadd x dx) (fdiv (fmul y dx) (fadd x dx)))
        (fdiv (fmul (fadd x dx) (fmul y dx)) (fadd x dx))
        (fun z => fsub (fmul (fadd x dx) y) z)
        (mulDivAssoc (fadd x dx) (fmul y dx) (fadd x dx)))
    (trans0 F
      (fsub (fmul (fadd x dx) y) (fdiv (fmul (fadd x dx) (fmul y dx)) (fadd x dx)))
      (fsub (fmul (fadd x dx) y) (fmul y dx))
      (fmul x y)
      (cong0 F F
        (fdiv (fmul (fadd x dx) (fmul y dx)) (fadd x dx))
        (fmul y dx)
        (fun z => fsub (fmul (fadd x dx) y) z)
        (mulDivCancelLeft (fadd x dx) (fmul y dx)
          (neOfGt (fadd x dx) (addPos x dx hx hdx))))
    (trans0 F
      (fsub (fmul (fadd x dx) y) (fmul y dx))
      (fsub (fadd (fmul x y) (fmul dx y)) (fmul y dx))
      (fmul x y)
      (cong0 F F
        (fmul (fadd x dx) y)
        (fadd (fmul x y) (fmul dx y))
        (fun z => fsub z (fmul y dx))
        (addMul x dx y))
    (trans0 F
      (fsub (fadd (fmul x y) (fmul dx y)) (fmul y dx))
      (fsub (fadd (fmul x y) (fmul dx y)) (fmul dx y))
      (fmul x y)
      (cong0 F F
        (fmul y dx)
        (fmul dx y)
        (fun z => fsub (fadd (fmul x y) (fmul dx y)) z)
        (mulComm y dx))
      (addSubCancelRight (fmul x y) (fmul dx y))))))

check swapOutputIdentity
