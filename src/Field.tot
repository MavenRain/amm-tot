-- The eight field laws of the swap identity, bundled into one record.
-- The record plays the role of the three Mathlib instances that the Lean
-- theorem reads from instance resolution: Field F, LinearOrder F and
-- IsStrictOrderedRing F. It also plays the role of the eight lemma
-- citations of the Lean tactic block.
-- The seven parameters carry the 0 marker, because a data type parameter
-- must carry that marker. The eight constructor fields carry quantity w,
-- because a def projects each one into a w position, and a 0 field fails
-- on projection with an erased-variable-used-at-runtime error.
data FieldLaws (0 F : Type 0) (0 fadd : F -> F -> F) (0 fmul : F -> F -> F)
    (0 fsub : F -> F -> F) (0 fdiv : F -> F -> F) (0 fzero : F)
    (0 flt : F -> F -> Type 0) : Type 0 :=
  | fieldLaws :
    (addPos : (a : F) -> (b : F) -> (0 ha : flt fzero a) -> (0 hb : flt fzero b) -> flt fzero (fadd a b)) ->
    (neOfGt : (a : F) -> (0 h : flt fzero a) -> (0 e : Eq F a fzero) -> Empty) ->
    (mulSub : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul a (fsub b c)) (fsub (fmul a b) (fmul a c))) ->
    (mulDivAssoc : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul a (fdiv b c)) (fdiv (fmul a b) c)) ->
    (mulDivCancelLeft : (a : F) -> (b : F) -> (0 hne : (0 e : Eq F a fzero) -> Empty) -> Eq F (fdiv (fmul a b) a) b) ->
    (addMul : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul (fadd a b) c) (fadd (fmul a c) (fmul b c))) ->
    (mulComm : (a : F) -> (b : F) -> Eq F (fmul a b) (fmul b a)) ->
    (addSubCancelRight : (a : F) -> (b : F) -> Eq F (fsub (fadd a b) b) a) ->
    FieldLaws F fadd fmul fsub fdiv fzero flt

def lawAddPos : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (b : F) -> (0 ha : flt fzero a) -> (0 hb : flt fzero b) -> flt fzero (fadd a b) :=
  fun F fadd fmul fsub fdiv fzero flt L a b ha hb =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => addPos a b ha hb
    end

def lawNeOfGt : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (0 h : flt fzero a) -> (0 e : Eq F a fzero) -> Empty :=
  fun F fadd fmul fsub fdiv fzero flt L a h e =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => neOfGt a h e
    end

def lawMulSub : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (b : F) -> (c : F) -> Eq F (fmul a (fsub b c)) (fsub (fmul a b) (fmul a c)) :=
  fun F fadd fmul fsub fdiv fzero flt L a b c =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => mulSub a b c
    end

def lawMulDivAssoc : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (b : F) -> (c : F) -> Eq F (fmul a (fdiv b c)) (fdiv (fmul a b) c) :=
  fun F fadd fmul fsub fdiv fzero flt L a b c =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => mulDivAssoc a b c
    end

def lawMulDivCancelLeft : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (b : F) -> (0 hne : (0 e : Eq F a fzero) -> Empty) -> Eq F (fdiv (fmul a b) a) b :=
  fun F fadd fmul fsub fdiv fzero flt L a b hne =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => mulDivCancelLeft a b hne
    end

def lawAddMul : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (b : F) -> (c : F) -> Eq F (fmul (fadd a b) c) (fadd (fmul a c) (fmul b c)) :=
  fun F fadd fmul fsub fdiv fzero flt L a b c =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => addMul a b c
    end

def lawMulComm : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (b : F) -> Eq F (fmul a b) (fmul b a) :=
  fun F fadd fmul fsub fdiv fzero flt L a b =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => mulComm a b
    end

def lawAddSubCancelRight : (0 F : Type 0) -> (0 fadd : F -> F -> F) -> (0 fmul : F -> F -> F) ->
    (0 fsub : F -> F -> F) -> (0 fdiv : F -> F -> F) -> (0 fzero : F) -> (0 flt : F -> F -> Type 0) ->
    (L : FieldLaws F fadd fmul fsub fdiv fzero flt) ->
    (a : F) -> (b : F) -> Eq F (fsub (fadd a b) b) a :=
  fun F fadd fmul fsub fdiv fzero flt L a b =>
    match L with
    | fieldLaws addPos neOfGt mulSub mulDivAssoc mulDivCancelLeft addMul mulComm addSubCancelRight => addSubCancelRight a b
    end

check lawAddPos
check lawNeOfGt
check lawMulSub
check lawMulDivAssoc
check lawMulDivCancelLeft
check lawAddMul
check lawMulComm
check lawAddSubCancelRight
