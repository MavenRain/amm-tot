-- The price impact theorems of AmmLean/PriceImpact.lean, stated on
-- effectivePrice and spotPrice of src/Basic.tot.
-- effectivePrice unfolds twice: delta of effectivePrice gives
-- fdiv (swapOutput p dx) dx, and delta of swapOutput then gives
-- fdiv (fdiv (fmul ry dx) (fadd rx dx)) dx.
-- effectivePriceEq folds that unfolding into one identity, and the other
-- four theorems transport along it.
-- Every theorem is a plain def over the eleven parameters, because no
-- statement in M3d reads the unfolding of an M3d def.
-- The check lines stand at the end of the file, one for each def.

def effectivePriceEq :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  Eq F
    (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
    (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    trans0 F
      (fdiv (fdiv (fmul (poolReserveY F fzero flt p) dx) (fadd (poolReserveX F fzero flt p) dx)) dx)
      (fdiv (fmul (poolReserveY F fzero flt p) dx) (fmul (fadd (poolReserveX F fzero flt p) dx) dx))
      (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx))
      (divDiv F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (fmul (poolReserveY F fzero flt p) dx)
        (fadd (poolReserveX F fzero flt p) dx)
        dx
        (reserveXAddNeZero F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
        (deriveNeOfGt F fadd fmul fsub fdiv fneg finv fzero fone flt A dx hdx))
      (mulDivMulRight F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (poolReserveY F fzero flt p)
        (fadd (poolReserveX F fzero flt p) dx)
        dx
        (reserveXAddNeZero F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
        (deriveNeOfGt F fadd fmul fsub fdiv fneg finv fzero fone flt A dx hdx))

check effectivePriceEq

def effectivePriceLtSpot :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt
    (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
    (spotPrice F fadd fmul fsub fdiv fneg finv fzero fone flt p) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    subst0 F
      (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx))
      (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
      (fun z => flt z (fdiv (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)))
      (sym0 F
        (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
        (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx))
        (effectivePriceEq F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))
      (divLtDivOfPosLeft F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (poolReserveY F fzero flt p)
        (fadd (poolReserveX F fzero flt p) dx)
        (poolReserveX F fzero flt p)
        (poolHy F fzero flt p)
        (poolHx F fzero flt p)
        (ltAddOfPosRight F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (poolReserveX F fzero flt p)
          dx
          hdx))

check effectivePriceLtSpot

def effectivePriceDecreasing :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx1 : F) -> (dx2 : F) ->
  (hdx1 : flt fzero dx1) -> (hdx2 : flt fzero dx2) -> (h : flt dx1 dx2) ->
  flt
    (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx2)
    (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx1) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx1 dx2 hdx1 hdx2 h =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      subst0 F
        (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx1))
        (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx1)
        (fun z => flt (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx2) z)
        (sym0 F
          (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx1)
          (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx1))
          (effectivePriceEq F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx1 hdx1))
        (subst0 F
          (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx2))
          (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx2)
          (fun z => flt z (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx1)))
          (sym0 F
            (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx2)
            (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx2))
            (effectivePriceEq F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx2 hdx2))
          (divLtDivOfPosLeft F fadd fmul fsub fdiv fneg finv fzero fone flt A
            (poolReserveY F fzero flt p)
            (fadd (poolReserveX F fzero flt p) dx2)
            (fadd (poolReserveX F fzero flt p) dx1)
            (poolHy F fzero flt p)
            (reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx1 hdx1)
            (addLtAddLeft (poolReserveX F fzero flt p) dx1 dx2 h)))
    end

check effectivePriceDecreasing

def effectivePriceLeSpot :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  fle F flt
    (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
    (spotPrice F fadd fmul fsub fdiv fneg finv fzero fone flt p) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    leOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
      (spotPrice F fadd fmul fsub fdiv fneg finv fzero fone flt p)
      (effectivePriceLtSpot F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)

check effectivePriceLeSpot

def effectivePricePos :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    subst0 F
      (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx))
      (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
      (fun z => flt fzero z)
      (sym0 F
        (effectivePrice F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
        (fdiv (poolReserveY F fzero flt p) (fadd (poolReserveX F fzero flt p) dx))
        (effectivePriceEq F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))
      (divPos F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (poolReserveY F fzero flt p)
        (fadd (poolReserveX F fzero flt p) dx)
        (poolHy F fzero flt p)
        (reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))

check effectivePricePos
