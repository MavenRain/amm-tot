-- The integers, their ring laws, their order and the interface that
-- M4c, M4d and M4e read. This is M4b, the second slice of the concrete
-- carrier, and the file stands after src/Nat.tot in the check order.
-- data Int is the Lean core shape: pos n is n, and negsucc n is the
-- negation of succ n. Zero is pos zero and one is pos one.
-- The arithmetic rides one canonical difference function, intMk a b,
-- which is a minus b in canonical form. intMk (succ a) (succ b) is
-- intMk a b by conversion, so the shift needs no lemma, and every law
-- is one equational chain over intMk forms.
-- A plain def rec is opaque to conversion, so every computing def is a
-- reducible def rec (intMk) or a reducible def (intZero, intOne,
-- negOfNat, intNeg, intAdd, intMul, natAbs, intFamPos, intLt). Every
-- proof is a plain def or a plain def rec.
-- The structural guard accepts recursion on an argument that is not
-- the first, so intAddPosMk, intAddNegsuccMk, intMulPosMk and
-- intMulNegsuccMk hold the factor m first and recur on c.
-- data IntRepr and intReprOf say that every integer is a canonical
-- difference. A law of three variables, or a law that mixes intAdd and
-- intMul, is a wrapper that opens the representations and transports
-- its goal to a core lemma on intMk forms. A law of one or two
-- variables is a direct constructor split, which is cheaper.
-- The order record IntLt erases its witness fields, so the four order
-- laws accept erased hypotheses, as OrderedField requires. intLt wraps
-- IntLt to give Trichotomy a relation with quantity w parameters.
-- The check lines stand at the end of the file, one for each def.

data Int : Type 0 := | pos : (n : Nat) -> Int | negsucc : (n : Nat) -> Int

reducible def intZero : Int := pos zero

reducible def intOne : Int := pos one

reducible def negOfNat : Nat -> Int :=
  fun n => match n with | zero => pos zero | succ p => negsucc p end

reducible def rec intMk : Nat -> Nat -> Int :=
  fun a b => match a with
    | zero => negOfNat b
    | succ p => match b with | zero => pos (succ p) | succ q => intMk p q end
    end

reducible def intNeg : Int -> Int :=
  fun x => match x with | pos n => negOfNat n | negsucc n => pos (succ n) end

reducible def intAdd : Int -> Int -> Int :=
  fun x y => match x with
    | pos m => match y with
        | pos n => pos (add m n)
        | negsucc n => intMk m (succ n)
        end
    | negsucc m => match y with
        | pos n => intMk n (succ m)
        | negsucc n => negsucc (succ (add m n))
        end
    end

reducible def intMul : Int -> Int -> Int :=
  fun x y => match x with
    | pos m => match y with
        | pos n => pos (mul m n)
        | negsucc n => negOfNat (mul m (succ n))
        end
    | negsucc m => match y with
        | pos n => negOfNat (mul (succ m) n)
        | negsucc n => pos (mul (succ m) (succ n))
        end
    end

reducible def natAbs : Int -> Nat :=
  fun x => match x with | pos n => n | negsucc n => succ n end

reducible def intFamPos : Int -> Type 0 :=
  fun x => match x with | pos n => Eq Nat zero zero | negsucc n => Empty end

def posInj : (0 m : Nat) -> (0 n : Nat) -> (0 h : Eq Int (pos m) (pos n)) -> Eq Nat m n :=
  fun m n h => cong0 Int Nat (pos m) (pos n) natAbs h

def negsuccInj : (0 m : Nat) -> (0 n : Nat) -> (0 h : Eq Int (negsucc m) (negsucc n)) -> Eq Nat m n :=
  fun m n h => succInj m n (cong0 Int Nat (negsucc m) (negsucc n) natAbs h)

def posNeNegsucc : (0 m : Nat) -> (0 n : Nat) -> (0 h : Eq Int (pos m) (negsucc n)) -> Empty :=
  fun m n h => subst0 Int (pos m) (negsucc n) intFamPos h (refl Nat zero)

def natAbsNegOfNat : (n : Nat) -> Eq Nat (natAbs (negOfNat n)) n :=
  fun n => match n as x return Eq Nat (natAbs (negOfNat x)) x with
    | zero => refl Nat zero
    | succ p => refl Nat (succ p)
    end

def intMkPos : (n : Nat) -> Eq Int (intMk n zero) (pos n) :=
  fun n => match n as x return Eq Int (intMk x zero) (pos x) with
    | zero => refl Int (pos zero)
    | succ p => refl Int (pos (succ p))
    end

def intMkNegsucc : (n : Nat) -> Eq Int (intMk zero (succ n)) (negsucc n) :=
  fun n => refl Int (negsucc n)

def rec intMkAddCancel : (k : Nat) -> (a : Nat) -> (b : Nat) ->
    Eq Int (intMk (add k a) (add k b)) (intMk a b) :=
  fun k a b => match k as x return Eq Int (intMk (add x a) (add x b)) (intMk a b) with
    | zero => refl Int (intMk a b)
    | succ p => intMkAddCancel p a b
    end

def intMkCong2 : (0 a : Nat) -> (0 b : Nat) -> (0 c : Nat) -> (0 d : Nat) ->
    (0 e1 : Eq Nat a c) -> (0 e2 : Eq Nat b d) -> Eq Int (intMk a b) (intMk c d) :=
  fun a b c d e1 e2 =>
    trans0 Int (intMk a b) (intMk c b) (intMk c d)
      (cong0 Nat Int a c (fun z => intMk z b) e1)
      (cong0 Nat Int b d (fun z => intMk c z) e2)

def intMkEqOfAdd : (p : Nat) -> (q : Nat) -> (r : Nat) -> (s : Nat) ->
    (0 h : Eq Nat (add p s) (add r q)) -> Eq Int (intMk p q) (intMk r s) :=
  fun p q r s h =>
    trans0 Int (intMk p q) (intMk (add s p) (add s q)) (intMk r s)
      (sym0 Int (intMk (add s p) (add s q)) (intMk p q) (intMkAddCancel s p q))
      (trans0 Int (intMk (add s p) (add s q)) (intMk (add p s) (add q s)) (intMk r s)
        (intMkCong2 (add s p) (add s q) (add p s) (add q s)
          (addComm s p) (addComm s q))
        (trans0 Int (intMk (add p s) (add q s)) (intMk (add q r) (add q s)) (intMk r s)
          (intMkCong2 (add p s) (add q s) (add q r) (add q s)
            (trans0 Nat (add p s) (add r q) (add q r) h (addComm r q))
            (refl Nat (add q s)))
          (intMkAddCancel q r s)))

def rec intMkDiag : (n : Nat) -> Eq Int (intMk n n) (pos zero) :=
  fun n => match n as x return Eq Int (intMk x x) (pos zero) with
    | zero => refl Int (pos zero)
    | succ p => intMkDiag p
    end

data IntRepr (0 x : Int) : Type 0 :=
  | intRepr : (a : Nat) -> (b : Nat) -> (e : Eq Int (intMk a b) x) -> IntRepr x

def intReprOf : (x : Int) -> IntRepr x :=
  fun x => match x as y return IntRepr y with
    | pos n => intRepr (pos n) n zero (intMkPos n)
    | negsucc n => intRepr (negsucc n) zero (succ n) (refl Int (negsucc n))
    end

def intAddZeroLeft : (x : Int) -> Eq Int (intAdd (pos zero) x) x :=
  fun x => match x as y return Eq Int (intAdd (pos zero) y) y with
    | pos n => refl Int (pos n)
    | negsucc n => refl Int (negsucc n)
    end

def rec intAddPosMk : (m : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Int (intAdd (pos m) (intMk c d)) (intMk (add m c) d) :=
  fun m c d => match c as x return Eq Int (intAdd (pos m) (intMk x d)) (intMk (add m x) d) with
    | zero => match d as y return Eq Int (intAdd (pos m) (intMk zero y)) (intMk (add m zero) y) with
        | zero => sym0 Int (intMk (add m zero) zero) (pos (add m zero)) (intMkPos (add m zero))
        | succ q => intMkCong2 m (succ q) (add m zero) (succ q)
            (sym0 Nat (add m zero) m (addZero m)) (refl Nat (succ q))
        end
    | succ p => match d as y return Eq Int (intAdd (pos m) (intMk (succ p) y)) (intMk (add m (succ p)) y) with
        | zero => sym0 Int (intMk (add m (succ p)) zero) (pos (add m (succ p)))
            (intMkPos (add m (succ p)))
        | succ q => trans0 Int (intAdd (pos m) (intMk p q)) (intMk (add m p) q)
            (intMk (add m (succ p)) (succ q))
            (intAddPosMk m p q)
            (intMkCong2 (succ (add m p)) (succ q) (add m (succ p)) (succ q)
              (sym0 Nat (add m (succ p)) (succ (add m p)) (addSuccRight m p))
              (refl Nat (succ q)))
        end
    end

def rec intAddNegsuccMk : (m : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Int (intAdd (negsucc m) (intMk c d)) (intMk c (succ (add m d))) :=
  fun m c d => match c as x return Eq Int (intAdd (negsucc m) (intMk x d)) (intMk x (succ (add m d))) with
    | zero => match d as y return Eq Int (intAdd (negsucc m) (intMk zero y)) (intMk zero (succ (add m y))) with
        | zero => intMkCong2 zero (succ m) zero (succ (add m zero))
            (refl Nat zero)
            (cong0 Nat Nat m (add m zero) succ (sym0 Nat (add m zero) m (addZero m)))
        | succ q => cong0 Nat Int (succ (add m q)) (add m (succ q)) negsucc
            (sym0 Nat (add m (succ q)) (succ (add m q)) (addSuccRight m q))
        end
    | succ p => match d as y return Eq Int (intAdd (negsucc m) (intMk (succ p) y)) (intMk (succ p) (succ (add m y))) with
        | zero => intMkCong2 (succ p) (succ m) (succ p) (succ (add m zero))
            (refl Nat (succ p))
            (cong0 Nat Nat m (add m zero) succ (sym0 Nat (add m zero) m (addZero m)))
        | succ q => trans0 Int (intAdd (negsucc m) (intMk p q)) (intMk p (succ (add m q)))
            (intMk (succ p) (succ (add m (succ q))))
            (intAddNegsuccMk m p q)
            (intMkCong2 (succ p) (succ (succ (add m q))) (succ p) (succ (add m (succ q)))
              (refl Nat (succ p))
              (cong0 Nat Nat (succ (add m q)) (add m (succ q)) succ
                (sym0 Nat (add m (succ q)) (succ (add m q)) (addSuccRight m q))))
        end
    end

def rec intAddMk : (a : Nat) -> (b : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Int (intAdd (intMk a b) (intMk c d)) (intMk (add a c) (add b d)) :=
  fun a b c d => match a as x return Eq Int (intAdd (intMk x b) (intMk c d)) (intMk (add x c) (add b d)) with
    | zero => match b as y return Eq Int (intAdd (intMk zero y) (intMk c d)) (intMk (add zero c) (add y d)) with
        | zero => intAddZeroLeft (intMk c d)
        | succ q => intAddNegsuccMk q c d
        end
    | succ p => match b as y return Eq Int (intAdd (intMk (succ p) y) (intMk c d)) (intMk (add (succ p) c) (add y d)) with
        | zero => intAddPosMk (succ p) c d
        | succ q => intAddMk p q c d
        end
    end

def rec intNegMk : (a : Nat) -> (b : Nat) -> Eq Int (intNeg (intMk a b)) (intMk b a) :=
  fun a b => match a as x return Eq Int (intNeg (intMk x b)) (intMk b x) with
    | zero => match b as y return Eq Int (intNeg (intMk zero y)) (intMk y zero) with
        | zero => refl Int (pos zero)
        | succ q => refl Int (pos (succ q))
        end
    | succ p => match b as y return Eq Int (intNeg (intMk (succ p) y)) (intMk y (succ p)) with
        | zero => refl Int (negsucc p)
        | succ q => intNegMk p q
        end
    end

def intMulZeroLeft : (x : Int) -> Eq Int (intMul (pos zero) x) (pos zero) :=
  fun x => match x as y return Eq Int (intMul (pos zero) y) (pos zero) with
    | pos n => refl Int (pos zero)
    | negsucc n => refl Int (pos zero)
    end

def rec intMulPosMk : (m : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Int (intMul (pos m) (intMk c d)) (intMk (mul m c) (mul m d)) :=
  fun m c d => match c as x return Eq Int (intMul (pos m) (intMk x d)) (intMk (mul m x) (mul m d)) with
    | zero => match d as y return Eq Int (intMul (pos m) (intMk zero y)) (intMk (mul m zero) (mul m y)) with
        | zero => trans0 Int (pos (mul m zero)) (pos zero) (intMk (mul m zero) (mul m zero))
            (cong0 Nat Int (mul m zero) zero pos (mulZeroRight m))
            (sym0 Int (intMk (mul m zero) (mul m zero)) (pos zero) (intMkDiag (mul m zero)))
        | succ q => intMkCong2 zero (mul m (succ q)) (mul m zero) (mul m (succ q))
            (sym0 Nat (mul m zero) zero (mulZeroRight m))
            (refl Nat (mul m (succ q)))
        end
    | succ p => match d as y return Eq Int (intMul (pos m) (intMk (succ p) y)) (intMk (mul m (succ p)) (mul m y)) with
        | zero => trans0 Int (pos (mul m (succ p))) (intMk (mul m (succ p)) zero)
            (intMk (mul m (succ p)) (mul m zero))
            (sym0 Int (intMk (mul m (succ p)) zero) (pos (mul m (succ p)))
              (intMkPos (mul m (succ p))))
            (intMkCong2 (mul m (succ p)) zero (mul m (succ p)) (mul m zero)
              (refl Nat (mul m (succ p)))
              (sym0 Nat (mul m zero) zero (mulZeroRight m)))
        | succ q => trans0 Int (intMul (pos m) (intMk p q)) (intMk (mul m p) (mul m q))
            (intMk (mul m (succ p)) (mul m (succ q)))
            (intMulPosMk m p q)
            (trans0 Int (intMk (mul m p) (mul m q))
              (intMk (add m (mul m p)) (add m (mul m q)))
              (intMk (mul m (succ p)) (mul m (succ q)))
              (sym0 Int (intMk (add m (mul m p)) (add m (mul m q))) (intMk (mul m p) (mul m q))
                (intMkAddCancel m (mul m p) (mul m q)))
              (intMkCong2 (add m (mul m p)) (add m (mul m q)) (mul m (succ p)) (mul m (succ q))
                (sym0 Nat (mul m (succ p)) (add m (mul m p)) (mulSuccRight m p))
                (sym0 Nat (mul m (succ q)) (add m (mul m q)) (mulSuccRight m q))))
        end
    end

def rec intMulNegsuccMk : (m : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Int (intMul (negsucc m) (intMk c d)) (intMk (mul (succ m) d) (mul (succ m) c)) :=
  fun m c d => match c as x return Eq Int (intMul (negsucc m) (intMk x d)) (intMk (mul (succ m) d) (mul (succ m) x)) with
    | zero => match d as y return Eq Int (intMul (negsucc m) (intMk zero y)) (intMk (mul (succ m) y) (mul (succ m) zero)) with
        | zero => trans0 Int (negOfNat (mul (succ m) zero)) (pos zero)
            (intMk (mul (succ m) zero) (mul (succ m) zero))
            (cong0 Nat Int (mul (succ m) zero) zero negOfNat (mulZeroRight (succ m)))
            (sym0 Int (intMk (mul (succ m) zero) (mul (succ m) zero)) (pos zero)
              (intMkDiag (mul (succ m) zero)))
        | succ q => trans0 Int (pos (mul (succ m) (succ q))) (intMk (mul (succ m) (succ q)) zero)
            (intMk (mul (succ m) (succ q)) (mul (succ m) zero))
            (sym0 Int (intMk (mul (succ m) (succ q)) zero) (pos (mul (succ m) (succ q)))
              (intMkPos (mul (succ m) (succ q))))
            (intMkCong2 (mul (succ m) (succ q)) zero (mul (succ m) (succ q)) (mul (succ m) zero)
              (refl Nat (mul (succ m) (succ q)))
              (sym0 Nat (mul (succ m) zero) zero (mulZeroRight (succ m))))
        end
    | succ p => match d as y return Eq Int (intMul (negsucc m) (intMk (succ p) y)) (intMk (mul (succ m) y) (mul (succ m) (succ p))) with
        | zero => intMkCong2 zero (mul (succ m) (succ p)) (mul (succ m) zero) (mul (succ m) (succ p))
            (sym0 Nat (mul (succ m) zero) zero (mulZeroRight (succ m)))
            (refl Nat (mul (succ m) (succ p)))
        | succ q => trans0 Int (intMul (negsucc m) (intMk p q)) (intMk (mul (succ m) q) (mul (succ m) p))
            (intMk (mul (succ m) (succ q)) (mul (succ m) (succ p)))
            (intMulNegsuccMk m p q)
            (trans0 Int (intMk (mul (succ m) q) (mul (succ m) p))
              (intMk (add (succ m) (mul (succ m) q)) (add (succ m) (mul (succ m) p)))
              (intMk (mul (succ m) (succ q)) (mul (succ m) (succ p)))
              (sym0 Int (intMk (add (succ m) (mul (succ m) q)) (add (succ m) (mul (succ m) p)))
                (intMk (mul (succ m) q) (mul (succ m) p))
                (intMkAddCancel (succ m) (mul (succ m) q) (mul (succ m) p)))
              (intMkCong2 (add (succ m) (mul (succ m) q)) (add (succ m) (mul (succ m) p))
                (mul (succ m) (succ q)) (mul (succ m) (succ p))
                (sym0 Nat (mul (succ m) (succ q)) (add (succ m) (mul (succ m) q))
                  (mulSuccRight (succ m) q))
                (sym0 Nat (mul (succ m) (succ p)) (add (succ m) (mul (succ m) p))
                  (mulSuccRight (succ m) p))))
        end
    end

def natAddShuffle : (a : Nat) -> (b : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Nat (add (add a b) (add c d)) (add (add a c) (add b d)) :=
  fun a b c d =>
    trans0 Nat (add (add a b) (add c d)) (add a (add b (add c d))) (add (add a c) (add b d))
      (addAssoc a b (add c d))
      (trans0 Nat (add a (add b (add c d))) (add a (add c (add b d))) (add (add a c) (add b d))
        (cong0 Nat Nat (add b (add c d)) (add c (add b d)) (fun z => add a z)
          (addLeftComm b c d))
        (sym0 Nat (add (add a c) (add b d)) (add a (add c (add b d)))
          (addAssoc a c (add b d))))

def rec intMulMk : (a : Nat) -> (b : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Int (intMul (intMk a b) (intMk c d))
      (intMk (add (mul a c) (mul b d)) (add (mul a d) (mul b c))) :=
  fun a b c d => match a as x return Eq Int (intMul (intMk x b) (intMk c d))
      (intMk (add (mul x c) (mul b d)) (add (mul x d) (mul b c))) with
    | zero => match b as y return Eq Int (intMul (intMk zero y) (intMk c d))
        (intMk (add (mul zero c) (mul y d)) (add (mul zero d) (mul y c))) with
        | zero => intMulZeroLeft (intMk c d)
        | succ q => intMulNegsuccMk q c d
        end
    | succ p => match b as y return Eq Int (intMul (intMk (succ p) y) (intMk c d))
        (intMk (add (mul (succ p) c) (mul y d)) (add (mul (succ p) d) (mul y c))) with
        | zero => trans0 Int (intMul (pos (succ p)) (intMk c d))
            (intMk (mul (succ p) c) (mul (succ p) d))
            (intMk (add (mul (succ p) c) zero) (add (mul (succ p) d) zero))
            (intMulPosMk (succ p) c d)
            (intMkCong2 (mul (succ p) c) (mul (succ p) d)
              (add (mul (succ p) c) zero) (add (mul (succ p) d) zero)
              (sym0 Nat (add (mul (succ p) c) zero) (mul (succ p) c) (addZero (mul (succ p) c)))
              (sym0 Nat (add (mul (succ p) d) zero) (mul (succ p) d) (addZero (mul (succ p) d))))
        | succ q => trans0 Int (intMul (intMk p q) (intMk c d))
            (intMk (add (mul p c) (mul q d)) (add (mul p d) (mul q c)))
            (intMk (add (add c (mul p c)) (add d (mul q d))) (add (add d (mul p d)) (add c (mul q c))))
            (intMulMk p q c d)
            (trans0 Int (intMk (add (mul p c) (mul q d)) (add (mul p d) (mul q c)))
              (intMk (add (add c d) (add (mul p c) (mul q d))) (add (add c d) (add (mul p d) (mul q c))))
              (intMk (add (add c (mul p c)) (add d (mul q d))) (add (add d (mul p d)) (add c (mul q c))))
              (sym0 Int (intMk (add (add c d) (add (mul p c) (mul q d))) (add (add c d) (add (mul p d) (mul q c))))
                (intMk (add (mul p c) (mul q d)) (add (mul p d) (mul q c)))
                (intMkAddCancel (add c d) (add (mul p c) (mul q d)) (add (mul p d) (mul q c))))
              (intMkCong2 (add (add c d) (add (mul p c) (mul q d))) (add (add c d) (add (mul p d) (mul q c)))
                (add (add c (mul p c)) (add d (mul q d))) (add (add d (mul p d)) (add c (mul q c)))
                (natAddShuffle c d (mul p c) (mul q d))
                (trans0 Nat (add (add c d) (add (mul p d) (mul q c)))
                  (add (add d c) (add (mul p d) (mul q c)))
                  (add (add d (mul p d)) (add c (mul q c)))
                  (cong0 Nat Nat (add c d) (add d c) (fun z => add z (add (mul p d) (mul q c)))
                    (addComm c d))
                  (natAddShuffle d c (mul p d) (mul q c)))))
        end
    end

def intAddComm : (a : Int) -> (b : Int) -> Eq Int (intAdd a b) (intAdd b a) :=
  fun a b => match a as x return Eq Int (intAdd x b) (intAdd b x) with
    | pos m => match b as y return Eq Int (intAdd (pos m) y) (intAdd y (pos m)) with
        | pos n => cong0 Nat Int (add m n) (add n m) pos (addComm m n)
        | negsucc n => refl Int (intMk m (succ n))
        end
    | negsucc m => match b as y return Eq Int (intAdd (negsucc m) y) (intAdd y (negsucc m)) with
        | pos n => refl Int (intMk n (succ m))
        | negsucc n => cong0 Nat Int (add m n) (add n m) (fun z => negsucc (succ z)) (addComm m n)
        end
    end

def intAddAssocCore : (a : Nat) -> (b : Nat) -> (c : Nat) -> (d : Nat) -> (e : Nat) -> (f : Nat) ->
    Eq Int (intAdd (intAdd (intMk a b) (intMk c d)) (intMk e f))
      (intAdd (intMk a b) (intAdd (intMk c d) (intMk e f))) :=
  fun a b c d e f =>
    trans0 Int
      (intAdd (intAdd (intMk a b) (intMk c d)) (intMk e f))
      (intMk (add (add a c) e) (add (add b d) f))
      (intAdd (intMk a b) (intAdd (intMk c d) (intMk e f)))
      (trans0 Int
        (intAdd (intAdd (intMk a b) (intMk c d)) (intMk e f))
        (intAdd (intMk (add a c) (add b d)) (intMk e f))
        (intMk (add (add a c) e) (add (add b d) f))
        (cong0 Int Int (intAdd (intMk a b) (intMk c d)) (intMk (add a c) (add b d))
          (fun z => intAdd z (intMk e f)) (intAddMk a b c d))
        (intAddMk (add a c) (add b d) e f))
      (sym0 Int
        (intAdd (intMk a b) (intAdd (intMk c d) (intMk e f)))
        (intMk (add (add a c) e) (add (add b d) f))
        (trans0 Int
          (intAdd (intMk a b) (intAdd (intMk c d) (intMk e f)))
          (intAdd (intMk a b) (intMk (add c e) (add d f)))
          (intMk (add (add a c) e) (add (add b d) f))
          (cong0 Int Int (intAdd (intMk c d) (intMk e f)) (intMk (add c e) (add d f))
            (fun z => intAdd (intMk a b) z) (intAddMk c d e f))
          (trans0 Int
