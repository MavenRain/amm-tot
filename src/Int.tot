                (fun z => intAdd z (intMk (add (mul a e) (mul b f)) (add (mul a f) (mul b e))))
                (sym0 Int (intMul (intMk a b) (intMk c d))
                  (intMk (add (mul a c) (mul b d)) (add (mul a d) (mul b c)))
                  (intMulMk a b c d)))
              (cong0 Int Int (intMk (add (mul a e) (mul b f)) (add (mul a f) (mul b e)))
                (intMul (intMk a b) (intMk e f))
                (fun z => intAdd (intMul (intMk a b) (intMk c d)) z)
                (sym0 Int (intMul (intMk a b) (intMk e f))
                  (intMk (add (mul a e) (mul b f)) (add (mul a f) (mul b e)))
                  (intMulMk a b e f)))))))

def intMulAdd : (x : Int) -> (y : Int) -> (z : Int) ->
    Eq Int (intMul x (intAdd y z)) (intAdd (intMul x y) (intMul x z)) :=
  fun x y z =>
    match intReprOf x as rx return
        Eq Int (intMul x (intAdd y z)) (intAdd (intMul x y) (intMul x z)) with
    | intRepr a b e =>
        match intReprOf y as ry return
            Eq Int (intMul x (intAdd y z)) (intAdd (intMul x y) (intMul x z)) with
        | intRepr c d f =>
            match intReprOf z as rz return
                Eq Int (intMul x (intAdd y z)) (intAdd (intMul x y) (intMul x z)) with
            | intRepr g h k =>
                subst0 Int (intMk a b) x
                  (fun w => Eq Int (intMul w (intAdd y z)) (intAdd (intMul w y) (intMul w z))) e
                  (subst0 Int (intMk c d) y
                    (fun w => Eq Int (intMul (intMk a b) (intAdd w z))
                      (intAdd (intMul (intMk a b) w) (intMul (intMk a b) z))) f
                    (subst0 Int (intMk g h) z
                      (fun w => Eq Int (intMul (intMk a b) (intAdd (intMk c d) w))
                        (intAdd (intMul (intMk a b) (intMk c d)) (intMul (intMk a b) w))) k
                      (intMulAddCore a b c d g h)))
            end
        end
    end

def intMulOne : (a : Int) -> Eq Int (intMul a intOne) a :=
  fun a => match a as x return Eq Int (intMul x intOne) x with
    | pos m => cong0 Nat Int (mul m one) m pos (mulOne m)
    | negsucc m => cong0 Nat Int (mul (succ m) one) (succ m) negOfNat (mulOne (succ m))
    end

def intMulZero : (a : Int) -> Eq Int (intMul a intZero) intZero :=
  fun a => match a as x return Eq Int (intMul x intZero) intZero with
    | pos m => cong0 Nat Int (mul m zero) zero pos (mulZeroRight m)
    | negsucc m => cong0 Nat Int (mul (succ m) zero) zero negOfNat (mulZeroRight (succ m))
    end

def intMulNegCore : (a : Nat) -> (b : Nat) -> (c : Nat) -> (d : Nat) ->
    Eq Int (intMul (intMk a b) (intNeg (intMk c d)))
      (intNeg (intMul (intMk a b) (intMk c d))) :=
  fun a b c d =>
    trans0 Int
      (intMul (intMk a b) (intNeg (intMk c d)))
      (intMul (intMk a b) (intMk d c))
      (intNeg (intMul (intMk a b) (intMk c d)))
      (cong0 Int Int (intNeg (intMk c d)) (intMk d c)
        (fun z => intMul (intMk a b) z)
        (intNegMk c d))
      (trans0 Int
        (intMul (intMk a b) (intMk d c))
        (intMk (add (mul a d) (mul b c)) (add (mul a c) (mul b d)))
        (intNeg (intMul (intMk a b) (intMk c d)))
        (intMulMk a b d c)
        (sym0 Int
          (intNeg (intMul (intMk a b) (intMk c d)))
          (intMk (add (mul a d) (mul b c)) (add (mul a c) (mul b d)))
          (trans0 Int
            (intNeg (intMul (intMk a b) (intMk c d)))
            (intNeg (intMk (add (mul a c) (mul b d)) (add (mul a d) (mul b c))))
            (intMk (add (mul a d) (mul b c)) (add (mul a c) (mul b d)))
            (cong0 Int Int (intMul (intMk a b) (intMk c d))
              (intMk (add (mul a c) (mul b d)) (add (mul a d) (mul b c)))
              intNeg
              (intMulMk a b c d))
            (intNegMk (add (mul a c) (mul b d)) (add (mul a d) (mul b c))))))

def intMulNeg : (k : Int) -> (y : Int) -> Eq Int (intMul k (intNeg y)) (intNeg (intMul k y)) :=
  fun k y =>
    match intReprOf k as rk return Eq Int (intMul k (intNeg y)) (intNeg (intMul k y)) with
    | intRepr a b e =>
        match intReprOf y as ry return Eq Int (intMul k (intNeg y)) (intNeg (intMul k y)) with
        | intRepr c d f =>
            subst0 Int (intMk a b) k
              (fun w => Eq Int (intMul w (intNeg y)) (intNeg (intMul w y))) e
              (subst0 Int (intMk c d) y
                (fun w => Eq Int (intMul (intMk a b) (intNeg w))
                  (intNeg (intMul (intMk a b) w))) f
                (intMulNegCore a b c d))
        end
    end

data IntLt (0 a : Int) (0 b : Int) : Type 0 :=
  | intLtWitness : (0 k : Nat) -> (0 e : Eq Int (intAdd a (pos (succ k))) b) -> IntLt a b

reducible def intLt : Int -> Int -> Type 0 := fun a b => IntLt a b

def intLtIrrefl : (a : Int) -> (0 h : intLt a a) -> Empty :=
  fun a h => match h as w return Empty with
    | intLtWitness k e =>
        zeroNotSucc k
          (sym0 Nat (succ k) zero
            (posInj (succ k) zero
              (intAddCancelLeft a (pos (succ k)) (pos zero)
                (trans0 Int (intAdd a (pos (succ k))) a (intAdd a (pos zero))
                  e
                  (sym0 Int (intAdd a (pos zero)) a (intAddZero a))))))
    end

def intLtTrans : (a : Int) -> (b : Int) -> (c : Int) ->
    (0 h1 : intLt a b) -> (0 h2 : intLt b c) -> intLt a c :=
  fun a b c h1 h2 => match h1 as w1 return intLt a c with
    | intLtWitness k1 e1 =>
        match h2 as w2 return intLt a c with
        | intLtWitness k2 e2 =>
            intLtWitness a c (add k1 (succ k2))
              (trans0 Int (intAdd a (pos (succ (add k1 (succ k2)))))
                (intAdd (intAdd a (pos (succ k1))) (pos (succ k2))) c
                (sym0 Int (intAdd (intAdd a (pos (succ k1))) (pos (succ k2)))
                  (intAdd a (pos (succ (add k1 (succ k2)))))
                  (intAddAssoc a (pos (succ k1)) (pos (succ k2))))
                (trans0 Int (intAdd (intAdd a (pos (succ k1))) (pos (succ k2)))
                  (intAdd b (pos (succ k2))) c
                  (cong0 Int Int (intAdd a (pos (succ k1))) b
                    (fun z => intAdd z (pos (succ k2))) e1)
                  e2))
        end
    end

def intAddLtAddLeft : (a : Int) -> (b : Int) -> (c : Int) ->
    (0 h : intLt b c) -> intLt (intAdd a b) (intAdd a c) :=
  fun a b c h => match h as w return intLt (intAdd a b) (intAdd a c) with
    | intLtWitness k e =>
        intLtWitness (intAdd a b) (intAdd a c) k
          (trans0 Int (intAdd (intAdd a b) (pos (succ k)))
            (intAdd a (intAdd b (pos (succ k)))) (intAdd a c)
            (intAddAssoc a b (pos (succ k)))
            (cong0 Int Int (intAdd b (pos (succ k))) c (fun z => intAdd a z) e))
    end

def intMulPos : (a : Int) -> (b : Int) ->
    (0 ha : intLt intZero a) -> (0 hb : intLt intZero b) -> intLt intZero (intMul a b) :=
  fun a b ha hb => match ha as w1 return intLt intZero (intMul a b) with
    | intLtWitness k1 e1 =>
        match hb as w2 return intLt intZero (intMul a b) with
        | intLtWitness k2 e2 =>
            intLtWitness intZero (intMul a b) (add k2 (mul k1 (succ k2)))
              (trans0 Int (intMul (pos (succ k1)) (pos (succ k2)))
                (intMul a (pos (succ k2))) (intMul a b)
                (cong0 Int Int (pos (succ k1)) a (fun z => intMul z (pos (succ k2))) e1)
                (cong0 Int Int (pos (succ k2)) b (fun z => intMul a z) e2))
        end
    end

def natAddRightComm : (a : Nat) -> (b : Nat) -> (c : Nat) ->
    Eq Nat (add (add a b) c) (add (add a c) b) :=
  fun a b c =>
    trans0 Nat (add (add a b) c) (add a (add b c)) (add (add a c) b)
      (addAssoc a b c)
      (trans0 Nat (add a (add b c)) (add a (add c b)) (add (add a c) b)
        (cong0 Nat Nat (add b c) (add c b) (fun z => add a z) (addComm b c))
        (sym0 Nat (add (add a c) b) (add a (add c b)) (addAssoc a c b)))

def intLtTrichotomyCore : (p : Nat) -> (q : Nat) -> (r : Nat) -> (s : Nat) ->
    Trichotomy Int intLt (intMk p q) (intMk r s) :=
  fun p q r s =>
    match ltTrichotomy (add p s) (add r q) as t
        return Trichotomy Int intLt (intMk p q) (intMk r s) with
    | isLt h =>
        match h as w return Trichotomy Int intLt (intMk p q) (intMk r s) with
        | ltWitness k e =>
            isLt Int intLt (intMk p q) (intMk r s)
              (intLtWitness (intMk p q) (intMk r s) k
                (trans0 Int (intAdd (intMk p q) (pos (succ k)))
                  (intMk (add p (succ k)) (add q zero)) (intMk r s)
                  (intAddMk p q (succ k) zero)
                  (intMkEqOfAdd (add p (succ k)) (add q zero) r s
                    (trans0 Nat (add (add p (succ k)) s) (add (add p s) (succ k))
                      (add r (add q zero))
                      (natAddRightComm p (succ k) s)
                      (trans0 Nat (add (add p s) (succ k)) (add r q) (add r (add q zero))
                        e
                        (cong0 Nat Nat q (add q zero) (fun z => add r z)
                          (sym0 Nat (add q zero) q (addZero q))))))))
        end
    | isEq e =>
        isEq Int intLt (intMk p q) (intMk r s) (intMkEqOfAdd p q r s e)
    | isGt h =>
        match h as w return Trichotomy Int intLt (intMk p q) (intMk r s) with
        | ltWitness k e =>
            isGt Int intLt (intMk p q) (intMk r s)
              (intLtWitness (intMk r s) (intMk p q) k
                (trans0 Int (intAdd (intMk r s) (pos (succ k)))
                  (intMk (add r (succ k)) (add s zero)) (intMk p q)
                  (intAddMk r s (succ k) zero)
                  (intMkEqOfAdd (add r (succ k)) (add s zero) p q
                    (trans0 Nat (add (add r (succ k)) q) (add (add r q) (succ k))
                      (add p (add s zero))
                      (natAddRightComm r (succ k) q)
                      (trans0 Nat (add (add r q) (succ k)) (add p s) (add p (add s zero))
                        e
                        (cong0 Nat Nat s (add s zero) (fun z => add p z)
                          (sym0 Nat (add s zero) s (addZero s))))))))
        end
    end

def intLtTrichotomy : (x : Int) -> (y : Int) -> Trichotomy Int intLt x y :=
  fun x y =>
    match intReprOf x as rx return Trichotomy Int intLt x y with
    | intRepr a b e =>
        match intReprOf y as ry return Trichotomy Int intLt x y with
        | intRepr c d f =>
            subst0 Int (intMk a b) x (fun w => Trichotomy Int intLt w y) e
              (subst0 Int (intMk c d) y (fun w => Trichotomy Int intLt (intMk a b) w) f
                (intLtTrichotomyCore a b c d))
        end
    end

def intZeroNeOne : (0 e : Eq Int intZero intOne) -> Empty :=
  fun e => zeroNeOne (posInj zero one e)

def natAbsMul : (a : Int) -> (b : Int) ->
    Eq Nat (natAbs (intMul a b)) (mul (natAbs a) (natAbs b)) :=
  fun a b => match a as x return Eq Nat (natAbs (intMul x b)) (mul (natAbs x) (natAbs b)) with
    | pos m =>
        match b as y return Eq Nat (natAbs (intMul (pos m) y)) (mul m (natAbs y)) with
        | pos n => refl Nat (mul m n)
        | negsucc n => natAbsNegOfNat (mul m (succ n))
        end
    | negsucc m =>
        match b as y return Eq Nat (natAbs (intMul (negsucc m) y)) (mul (succ m) (natAbs y)) with
        | pos n => natAbsNegOfNat (mul (succ m) n)
        | negsucc n => refl Nat (mul (succ m) (succ n))
        end
    end

def natMulEqZeroRight : (m : Nat) -> (n : Nat) -> (hm : Eq Nat m zero -> Empty) ->
    (h : Eq Nat (mul m n) zero) -> Eq Nat n zero :=
  fun m n hm h =>
    (match m as x return (hmx : Eq Nat x zero -> Empty) ->
        (hx : Eq Nat (mul x n) zero) -> Eq Nat n zero with
     | zero => fun hmz hz => match hmz (refl Nat zero) as w return Eq Nat n zero with end
     | succ p => fun hms hs =>
         (match n as y return (hy : Eq Nat (mul (succ p) y) zero) -> Eq Nat y zero with
          | zero => fun hy => refl Nat zero
          | succ q => fun hy =>
              match zeroNotSucc (add q (mul p (succ q)))
                  (sym0 Nat (mul (succ p) (succ q)) zero hy) as w
                  return Eq Nat (succ q) zero with end
          end) hs
     end) hm h

def intEqZeroOfNatAbs : (z : Int) -> (e : Eq Nat (natAbs z) zero) -> Eq Int z intZero :=
  fun z e =>
    (match z as x return (ex : Eq Nat (natAbs x) zero) -> Eq Int x intZero with
     | pos n => fun en => cong0 Nat Int n zero pos en
     | negsucc n => fun en =>
         match zeroNotSucc n (sym0 Nat (succ n) zero en) as w
             return Eq Int (negsucc n) intZero with end
     end) e

def intMulEqZeroRight : (k : Int) -> (z : Int) -> (hk : Eq Int k intZero -> Empty) ->
    (h : Eq Int (intMul k z) intZero) -> Eq Int z intZero :=
  fun k z hk h =>
    intEqZeroOfNatAbs z
      (natMulEqZeroRight (natAbs k) (natAbs z)
        (fun e => hk (intEqZeroOfNatAbs k e))
        (trans0 Nat (mul (natAbs k) (natAbs z)) (natAbs (intMul k z)) zero
          (sym0 Nat (natAbs (intMul k z)) (mul (natAbs k) (natAbs z)) (natAbsMul k z))
          (cong0 Int Nat (intMul k z) intZero natAbs h)))

def intMulCancelLeft : (k : Int) -> (x : Int) -> (y : Int) ->
    (hk : Eq Int k intZero -> Empty) ->
    (h : Eq Int (intMul k x) (intMul k y)) -> Eq Int x y :=
  fun k x y hk h =>
    trans0 Int x (intAdd x intZero) y
      (sym0 Int (intAdd x intZero) x (intAddZero x))
      (trans0 Int (intAdd x intZero) (intAdd x (intAdd (intNeg y) y)) y
        (cong0 Int Int intZero (intAdd (intNeg y) y) (fun w => intAdd x w)
          (sym0 Int (intAdd (intNeg y) y) intZero (intNegAddCancel y)))
        (trans0 Int (intAdd x (intAdd (intNeg y) y)) (intAdd (intAdd x (intNeg y)) y) y
          (sym0 Int (intAdd (intAdd x (intNeg y)) y) (intAdd x (intAdd (intNeg y) y))
            (intAddAssoc x (intNeg y) y))
          (trans0 Int (intAdd (intAdd x (intNeg y)) y) (intAdd intZero y) y
            (cong0 Int Int (intAdd x (intNeg y)) intZero (fun w => intAdd w y)
              (intMulEqZeroRight k (intAdd x (intNeg y)) hk
                (trans0 Int (intMul k (intAdd x (intNeg y)))
                  (intAdd (intMul k x) (intMul k (intNeg y))) intZero
                  (intMulAdd k x (intNeg y))
                  (trans0 Int (intAdd (intMul k x) (intMul k (intNeg y)))
                    (intAdd (intMul k y) (intMul k (intNeg y))) intZero
                    (cong0 Int Int (intMul k x) (intMul k y)
                      (fun w => intAdd w (intMul k (intNeg y))) h)
                    (trans0 Int (intAdd (intMul k y) (intMul k (intNeg y)))
                      (intAdd (intMul k y) (intNeg (intMul k y))) intZero
                      (cong0 Int Int (intMul k (intNeg y)) (intNeg (intMul k y))
                        (fun w => intAdd (intMul k y) w) (intMulNeg k y))
                      (intAddNegCancel (intMul k y)))))))
            (intAddZeroLeft y))))

def intDecEq : (x : Int) -> (y : Int) -> Dec (Eq Int x y) :=
  fun x y => match x as xx return Dec (Eq Int xx y) with
    | pos m =>
        match y as yy return Dec (Eq Int (pos m) yy) with
        | pos n =>
            match natDecEq m n as d return Dec (Eq Int (pos m) (pos n)) with
            | yes p => yes (Eq Int (pos m) (pos n)) (cong0 Nat Int m n pos p)
            | no np => no (Eq Int (pos m) (pos n)) (fun hh => np (posInj m n hh))
            end
        | negsucc n =>
            no (Eq Int (pos m) (negsucc n)) (fun hh => posNeNegsucc m n hh)
        end
    | negsucc m =>
        match y as yy return Dec (Eq Int (negsucc m) yy) with
        | pos n =>
            no (Eq Int (negsucc m) (pos n))
              (fun hh => posNeNegsucc n m (sym0 Int (negsucc m) (pos n) hh))
        | negsucc n =>
            match natDecEq m n as d return Dec (Eq Int (negsucc m) (negsucc n)) with
            | yes p => yes (Eq Int (negsucc m) (negsucc n)) (cong0 Nat Int m n negsucc p)
            | no np => no (Eq Int (negsucc m) (negsucc n)) (fun hh => np (negsuccInj m n hh))
            end
        end
    end

