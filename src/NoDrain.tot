-- The no-drain theorems of AmmLean/NoDrain.lean, stated on swapOutput,
-- swapOutputWithFee and swap of src/Basic.tot.
-- The file cites src/Product.tot, because NoDrain.lean imports
-- AmmLean.Invariant: constantProductLowerBound reads swapPreservesProduct,
-- and swapOutputWithFeeLtReserveY reads effectiveInputPos. src/Product.tot
-- therefore comes before this file in the check order.
-- swapOutputLtReserveY is the inner chain of swapHy without its outer
-- subPosOfLt, and swapOutputWithFeeLtReserveY is the inner chain of
-- swapWithFeeHy without its outer subPosOfLt. reserveYPosAfterSwap has the
-- type of swapHy, and it keeps the structure of the Lean proof.
-- The check lines stand at the end of the file, one for each def.

def swapOutputLtReserveY :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx) (poolReserveY F fzero flt p) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      divLtOfLtMul F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (fmul (poolReserveY F fzero flt p) dx)
        (poolReserveY F fzero flt p)
        (fadd (poolReserveX F fzero flt p) dx)
        (reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
        (subst0 F
          (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
            (fmul (poolReserveY F fzero flt p) dx))
          (fmul (poolReserveY F fzero flt p)
            (fadd (poolReserveX F fzero flt p) dx))
          (fun z => flt (fmul (poolReserveY F fzero flt p) dx) z)
          (sym0 F
            (fmul (poolReserveY F fzero flt p)
              (fadd (poolReserveX F fzero flt p) dx))
            (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
              (fmul (poolReserveY F fzero flt p) dx))
            (mulAdd (poolReserveY F fzero flt p) (poolReserveX F fzero flt p) dx))
          (ltAddOfPosLeft F fadd fmul fsub fdiv fneg finv fzero fone flt A
            (fmul (poolReserveY F fzero flt p) dx)
            (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
            (mulPos (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)
              (poolHy F fzero flt p) (poolHx F fzero flt p))))
    end

check swapOutputLtReserveY

def swapOutputPos :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      divPos F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (fmul (poolReserveY F fzero flt p) dx)
        (fadd (poolReserveX F fzero flt p) dx)
        (mulPos (poolReserveY F fzero flt p) dx (poolHy F fzero flt p) hdx)
        (reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
    end

check swapOutputPos

def swapOutputWithFeeLtReserveY :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) -> (f : FeeRate F fzero fone flt) ->
  flt (swapOutputWithFee F fadd fmul fsub fdiv fneg finv fzero fone flt p dx f)
    (poolReserveY F fzero flt p) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      divLtOfLtMul F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (fmul (poolReserveY F fzero flt p)
          (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))
        (poolReserveY F fzero flt p)
        (fadd (poolReserveX F fzero flt p)
          (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))
        (deriveAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (poolReserveX F fzero flt p)
          (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)
          (poolHx F fzero flt p)
          (effectiveInputPos F fadd fmul fsub fdiv fneg finv fzero fone flt A dx hdx f))
        (subst0 F
          (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
            (fmul (poolReserveY F fzero flt p)
              (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
          (fmul (poolReserveY F fzero flt p)
            (fadd (poolReserveX F fzero flt p)
              (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
          (fun z => flt (fmul (poolReserveY F fzero flt p)
            (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)) z)
          (sym0 F
            (fmul (poolReserveY F fzero flt p)
              (fadd (poolReserveX F fzero flt p)
                (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
            (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
              (fmul (poolReserveY F fzero flt p)
                (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
            (mulAdd (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)
              (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
          (ltAddOfPosLeft F fadd fmul fsub fdiv fneg finv fzero fone flt A
            (fmul (poolReserveY F fzero flt p)
              (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))
            (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
            (mulPos (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)
              (poolHy F fzero flt p) (poolHx F fzero flt p))))
    end

check swapOutputWithFeeLtReserveY

def reserveYPosAfterSwap :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero
    (fsub (poolReserveY F fzero flt p)
      (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (poolReserveY F fzero flt p)
      (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)
      (swapOutputLtReserveY F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)

check reserveYPosAfterSwap

def reserveYPosAfterSwapWithFee :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) -> (f : FeeRate F fzero fone flt) ->
  flt fzero
    (fsub (poolReserveY F fzero flt p)
      (swapOutputWithFee F fadd fmul fsub fdiv fneg finv fzero fone flt p dx f)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f =>
    subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (poolReserveY F fzero flt p)
      (swapOutputWithFee F fadd fmul fsub fdiv fneg finv fzero fone flt p dx f)
      (swapOutputWithFeeLtReserveY F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f)

check reserveYPosAfterSwapWithFee

def constantProductLowerBound :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  fle F flt
    (constantProduct F fadd fmul fsub fdiv fneg finv fzero fone flt p)
    (constantProduct F fadd fmul fsub fdiv fneg finv fzero fone flt
      (swap F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    leOfEq F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (constantProduct F fadd fmul fsub fdiv fneg finv fzero fone flt p)
      (constantProduct F fadd fmul fsub fdiv fneg finv fzero fone flt
        (swap F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))
      (sym0 F
        (constantProduct F fadd fmul fsub fdiv fneg finv fzero fone flt
          (swap F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))
        (constantProduct F fadd fmul fsub fdiv fneg finv fzero fone flt p)
        (swapPreservesProduct F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))

check constantProductLowerBound
