  fun a b c => ratRepEq (ratMul a (ratAdd b c)) (ratAdd (ratMul a b) (ratMul a c)) (intAdd
    (intMul (intMul (ratNum a) (ratNum b)) (intMul (pos (ratDen a)) (pos (ratDen c)))) (intMul
    (intMul (ratNum a) (ratNum c)) (intMul (pos (ratDen a)) (pos (ratDen b))))) (mul (mul
    (ratDen a) (ratDen b)) (mul (ratDen a) (ratDen c)))
    (ratFieldNatMulNeZero (mul (ratDen a) (ratDen b)) (mul (ratDen a) (ratDen c))
      (ratFieldNatMulNeZero (ratDen a) (ratDen b) (fun h => ratDenNeZero a h) (fun h =>
      ratDenNeZero b h)) (ratFieldNatMulNeZero (ratDen a) (ratDen c) (fun h => ratDenNeZero a h)
      (fun h => ratDenNeZero c h)))
    (ratRepCast (ratMul a (ratAdd b c)) (intMul (intMul (ratNum a) (intAdd (intMul (ratNum b)
      (pos (ratDen c))) (intMul (ratNum c) (pos (ratDen b))))) (pos (ratDen a))) (intAdd (intMul
      (intMul (ratNum a) (ratNum b)) (intMul (pos (ratDen a)) (pos (ratDen c)))) (intMul (intMul
      (ratNum a) (ratNum c)) (intMul (pos (ratDen a)) (pos (ratDen b))))) (mul (mul (ratDen a)
      (mul (ratDen b) (ratDen c))) (ratDen a)) (mul (mul (ratDen a) (ratDen b)) (mul (ratDen a)
      (ratDen c)))
      (ratFieldMulAddNum (ratNum a) (ratNum b) (ratNum c) (pos (ratDen a)) (pos (ratDen b)) (pos
        (ratDen c)))
      (trans0 Nat (mul (mul (ratDen a) (mul (ratDen b) (ratDen c))) (ratDen a)) (mul (ratDen a)
        (mul (ratDen a) (mul (ratDen b) (ratDen c)))) (mul (mul (ratDen a) (ratDen b)) (mul
        (ratDen a) (ratDen c)))
  (trans0 Nat (mul (mul (ratDen a) (mul (ratDen b) (ratDen c))) (ratDen a)) (mul (ratDen a) (mul
    (mul (ratDen b) (ratDen c)) (ratDen a))) (mul (ratDen a) (mul (ratDen a) (mul (ratDen b)
    (ratDen c))))
  (mulAssoc (ratDen a) (mul (ratDen b) (ratDen c)) (ratDen a))
  (cong0 Nat Nat (mul (mul (ratDen b) (ratDen c)) (ratDen a)) (mul (ratDen a) (mul (ratDen b)
    (ratDen c))) (fun qv => (mul (ratDen a) qv))
  (trans0 Nat (mul (mul (ratDen b) (ratDen c)) (ratDen a)) (mul (ratDen b) (mul (ratDen a)
    (ratDen c))) (mul (ratDen a) (mul (ratDen b) (ratDen c)))
  (trans0 Nat (mul (mul (ratDen b) (ratDen c)) (ratDen a)) (mul (ratDen b) (mul (ratDen c)
    (ratDen a))) (mul (ratDen b) (mul (ratDen a) (ratDen c)))
  (mulAssoc (ratDen b) (ratDen c) (ratDen a))
  (cong0 Nat Nat (mul (ratDen c) (ratDen a)) (mul (ratDen a) (ratDen c)) (fun qv => (mul (ratDen
    b) qv))
  (mulComm (ratDen c) (ratDen a))))
  (trans0 Nat (mul (ratDen b) (mul (ratDen a) (ratDen c))) (mul (mul (ratDen a) (ratDen b))
    (ratDen c)) (mul (ratDen a) (mul (ratDen b) (ratDen c)))
  (trans0 Nat (mul (ratDen b) (mul (ratDen a) (ratDen c))) (mul (mul (ratDen b) (ratDen a))
    (ratDen c)) (mul (mul (ratDen a) (ratDen b)) (ratDen c))
  (sym0 Nat (mul (mul (ratDen b) (ratDen a)) (ratDen c)) (mul (ratDen b) (mul (ratDen a) (ratDen
    c))) (mulAssoc (ratDen b) (ratDen a) (ratDen c)))
  (cong0 Nat Nat (mul (ratDen b) (ratDen a)) (mul (ratDen a) (ratDen b)) (fun qv => (mul qv
    (ratDen c)))
  (mulComm (ratDen b) (ratDen a))))
  (mulAssoc (ratDen a) (ratDen b) (ratDen c))))))
  (sym0 Nat (mul (mul (ratDen a) (ratDen b)) (mul (ratDen a) (ratDen c))) (mul (ratDen a) (mul
    (ratDen a) (mul (ratDen b) (ratDen c)))) (trans0 Nat (mul (mul (ratDen a) (ratDen b)) (mul
    (ratDen a) (ratDen c))) (mul (ratDen a) (mul (ratDen b) (mul (ratDen a) (ratDen c)))) (mul
    (ratDen a) (mul (ratDen a) (mul (ratDen b) (ratDen c))))
  (mulAssoc (ratDen a) (ratDen b) (mul (ratDen a) (ratDen c)))
  (cong0 Nat Nat (mul (ratDen b) (mul (ratDen a) (ratDen c))) (mul (ratDen a) (mul (ratDen b)
    (ratDen c))) (fun qv => (mul (ratDen a) qv))
  (trans0 Nat (mul (ratDen b) (mul (ratDen a) (ratDen c))) (mul (mul (ratDen a) (ratDen b))
    (ratDen c)) (mul (ratDen a) (mul (ratDen b) (ratDen c)))
  (trans0 Nat (mul (ratDen b) (mul (ratDen a) (ratDen c))) (mul (mul (ratDen b) (ratDen a))
    (ratDen c)) (mul (mul (ratDen a) (ratDen b)) (ratDen c))
  (sym0 Nat (mul (mul (ratDen b) (ratDen a)) (ratDen c)) (mul (ratDen b) (mul (ratDen a) (ratDen
    c))) (mulAssoc (ratDen b) (ratDen a) (ratDen c)))
  (cong0 Nat Nat (mul (ratDen b) (ratDen a)) (mul (ratDen a) (ratDen b)) (fun qv => (mul qv
    (ratDen c)))
  (mulComm (ratDen b) (ratDen a))))
  (mulAssoc (ratDen a) (ratDen b) (ratDen c)))))))
      (ratRepScale (ratMul a (ratAdd b c)) (intMul (ratNum a) (intAdd (intMul (ratNum b) (pos
        (ratDen c))) (intMul (ratNum c) (pos (ratDen b))))) (mul (ratDen a) (mul (ratDen b)
        (ratDen c))) (ratDen a) (ratMulRep a (ratAdd b c) (ratNum a) (intAdd (intMul (ratNum b)
        (pos (ratDen c))) (intMul (ratNum c) (pos (ratDen b)))) (ratDen a) (mul (ratDen b)
        (ratDen c))
    (ratRepSelf a)
    (ratAddRep b c (ratNum b) (ratNum c) (ratDen b) (ratDen c)
    (ratRepSelf b)
    (ratRepSelf c)))))
    (ratAddRep (ratMul a b) (ratMul a c) (intMul (ratNum a) (ratNum b)) (intMul (ratNum a)
      (ratNum c)) (mul (ratDen a) (ratDen b)) (mul (ratDen a) (ratDen c))
    (ratMulRep a b (ratNum a) (ratNum b) (ratDen a) (ratDen b)
    (ratRepSelf a)
    (ratRepSelf b))
    (ratMulRep a c (ratNum a) (ratNum c) (ratDen a) (ratDen c)
    (ratRepSelf a)
    (ratRepSelf c)))

def ratMulInvCancel : (a : Rat) -> (0 ha : (0 e : Eq Rat a ratZero) -> Empty) ->
    Eq Rat (ratMul a (ratInv a)) ratOne :=
  fun a ha => ratRepCrossEq (ratMul a (ratInv a)) ratOne
    (intMul (ratNum a) (ratNum (ratInv a))) intOne (mul (ratDen a) (ratDen (ratInv a))) one
    (ratFieldNatMulNeZero (ratDen a) (ratDen (ratInv a)) (fun h => ratDenNeZero a h) (fun h =>
      ratDenNeZero (ratInv a) h)) (fun h => zeroNeOne (sym0 Nat one zero h))
    (ratMulRep a (ratInv a) (ratNum a) (ratNum (ratInv a)) (ratDen a) (ratDen (ratInv a))
    (ratRepSelf a)
    (ratRepSelf (ratInv a))) (ratRepSelf ratOne)
    (trans0 Int (intMul (intMul (ratNum a) (ratNum (ratInv a))) intOne) (intMul (intMul (pos
      (ratDen a)) (pos (ratDen (ratInv a)))) intOne) (intMul intOne (intMul (pos (ratDen a))
      (pos (ratDen (ratInv a)))))
  (cong0 Int Int (intMul (ratNum a) (ratNum (ratInv a))) (intMul (pos (ratDen a)) (pos (ratDen
    (ratInv a)))) (fun qv => (intMul qv intOne))
  (ratInvCross a ha))
  (trans0 Int (intMul (intMul (pos (ratDen a)) (pos (ratDen (ratInv a)))) intOne) (intMul (pos
    (ratDen (ratInv a))) (pos (ratDen a))) (intMul intOne (intMul (pos (ratDen a)) (pos (ratDen
    (ratInv a)))))
  (trans0 Int (intMul (intMul (pos (ratDen a)) (pos (ratDen (ratInv a)))) intOne) (intMul
    (intMul (pos (ratDen (ratInv a))) (pos (ratDen a))) intOne) (intMul (pos (ratDen (ratInv
    a))) (pos (ratDen a)))
  (cong0 Int Int (intMul (pos (ratDen a)) (pos (ratDen (ratInv a)))) (intMul (pos (ratDen
    (ratInv a))) (pos (ratDen a))) (fun qv => (intMul qv intOne))
  (intMulComm (pos (ratDen a)) (pos (ratDen (ratInv a)))))
  (intMulOne (intMul (pos (ratDen (ratInv a))) (pos (ratDen a)))))
  (sym0 Int (intMul intOne (intMul (pos (ratDen a)) (pos (ratDen (ratInv a))))) (intMul (pos
    (ratDen (ratInv a))) (pos (ratDen a))) (trans0 Int (intMul intOne (intMul (pos (ratDen a))
    (pos (ratDen (ratInv a))))) (intMul intOne (intMul (pos (ratDen (ratInv a))) (pos (ratDen
    a)))) (intMul (pos (ratDen (ratInv a))) (pos (ratDen a)))
  (cong0 Int Int (intMul (pos (ratDen a)) (pos (ratDen (ratInv a)))) (intMul (pos (ratDen
    (ratInv a))) (pos (ratDen a))) (fun qv => (intMul intOne qv))
  (intMulComm (pos (ratDen a)) (pos (ratDen (ratInv a)))))
  (ratFieldIntOneMul (intMul (pos (ratDen (ratInv a))) (pos (ratDen a))))))))

