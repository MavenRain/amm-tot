-- Field laws for the computing Rat operations, proved through ratRep.
-- No field or order record is assumed. The representation helpers reduce
-- each equation to integer ring laws and nonzero denominator cancellation.

-- Integer rearrangements used by the rational field proofs.
def ratFieldIntOneMul : (a : Int) -> Eq Int (intMul intOne a) a :=
  fun a => trans0 Int (intMul intOne a) (intMul a intOne) a
    (intMulComm intOne a) (intMulOne a)

def ratFieldIntAddMul : (a : Int) -> (b : Int) -> (c : Int) ->
    Eq Int (intMul (intAdd a b) c) (intAdd (intMul a c) (intMul b c)) :=
  fun a b c => trans0 Int (intMul (intAdd a b) c)
    (intMul c (intAdd a b)) (intAdd (intMul a c) (intMul b c))
    (intMulComm (intAdd a b) c)
    (trans0 Int (intMul c (intAdd a b))
      (intAdd (intMul c a) (intMul c b)) (intAdd (intMul a c) (intMul b c))
      (intMulAdd c a b)
      (trans0 Int (intAdd (intMul c a) (intMul c b))
        (intAdd (intMul a c) (intMul c b)) (intAdd (intMul a c) (intMul b c))
        (cong0 Int Int (intMul c a) (intMul a c)
          (fun z => intAdd z (intMul c b)) (intMulComm c a))
        (cong0 Int Int (intMul c b) (intMul b c)
          (fun z => intAdd (intMul a c) z) (intMulComm c b))))

def ratFieldMulSwap : (a : Int) -> (b : Int) -> (d : Int) -> (e : Int) ->
    Eq Int (intMul (intMul a b) (intMul d e)) (intMul (intMul a d) (intMul b e)) :=
  fun a b d e => (trans0 Int (intMul (intMul a b) (intMul d e)) (intMul a (intMul b (intMul d
    e))) (intMul (intMul a d) (intMul b e))
  (intMulAssoc a b (intMul d e))
  (sym0 Int (intMul (intMul a d) (intMul b e)) (intMul a (intMul b (intMul d e))) (trans0 Int
    (intMul (intMul a d) (intMul b e)) (intMul a (intMul d (intMul b e))) (intMul a (intMul b
    (intMul d e)))
  (intMulAssoc a d (intMul b e))
  (cong0 Int Int (intMul d (intMul b e)) (intMul b (intMul d e)) (fun qv => (intMul a qv))
  (trans0 Int (intMul d (intMul b e)) (intMul (intMul b d) e) (intMul b (intMul d e))
  (trans0 Int (intMul d (intMul b e)) (intMul (intMul d b) e) (intMul (intMul b d) e)
  (sym0 Int (intMul (intMul d b) e) (intMul d (intMul b e)) (intMulAssoc d b e))
  (cong0 Int Int (intMul d b) (intMul b d) (fun qv => (intMul qv e))
  (intMulComm d b)))
  (intMulAssoc b d e))))))

def ratFieldMulRotate : (a : Int) -> (b : Int) -> (d : Int) -> (e : Int) ->
    Eq Int (intMul (intMul a b) (intMul d e)) (intMul (intMul a e) (intMul b d)) :=
  fun a b d e => (trans0 Int (intMul (intMul a b) (intMul d e)) (intMul a (intMul b (intMul d
    e))) (intMul (intMul a e) (intMul b d))
  (intMulAssoc a b (intMul d e))
  (sym0 Int (intMul (intMul a e) (intMul b d)) (intMul a (intMul b (intMul d e))) (trans0 Int
    (intMul (intMul a e) (intMul b d)) (intMul a (intMul e (intMul b d))) (intMul a (intMul b
    (intMul d e)))
  (intMulAssoc a e (intMul b d))
  (cong0 Int Int (intMul e (intMul b d)) (intMul b (intMul d e)) (fun qv => (intMul a qv))
  (trans0 Int (intMul e (intMul b d)) (intMul b (intMul e d)) (intMul b (intMul d e))
  (trans0 Int (intMul e (intMul b d)) (intMul (intMul b e) d) (intMul b (intMul e d))
  (trans0 Int (intMul e (intMul b d)) (intMul (intMul e b) d) (intMul (intMul b e) d)
  (sym0 Int (intMul (intMul e b) d) (intMul e (intMul b d)) (intMulAssoc e b d))
  (cong0 Int Int (intMul e b) (intMul b e) (fun qv => (intMul qv d))
  (intMulComm e b)))
  (intMulAssoc b e d))
  (cong0 Int Int (intMul e d) (intMul d e) (fun qv => (intMul b qv))
  (intMulComm e d)))))))

def ratFieldAddRepCore : (a : Int) -> (b : Int) -> (x : Int) -> (y : Int) ->
    (r : Int) -> (s : Int) -> (n : Int) -> (m : Int) -> (d : Int) -> (e : Int) ->
    (hk : Eq Int (intMul x y) intZero -> Empty) ->
    (0 h0 : Eq Int (intMul r (intMul x y)) (intMul (intAdd (intMul a y) (intMul b x)) s)) ->
    (0 h1 : Eq Int (intMul a d) (intMul n x)) ->
    (0 h2 : Eq Int (intMul b e) (intMul m y)) -> Eq Int (intMul r (intMul d e)) (intMul (intAdd
      (intMul n e) (intMul m d)) s) :=
  fun a b x y r s n m d e hk h0 h1 h2 => intMulCancelLeft (intMul x y) (intMul r (intMul d e))
    (intMul (intAdd (intMul n e) (intMul m d)) s) hk
    (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intAdd (intMul n
      e) (intMul m d)) (intMul x y)) s) (intMul (intMul x y) (intMul (intAdd (intMul n e)
      (intMul m d)) s))
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul n e)
    (intMul x y)) (intMul (intMul m d) (intMul x y))) s) (intMul (intMul (intAdd (intMul n e)
    (intMul m d)) (intMul x y)) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul n e)
    (intMul x y)) (intMul (intMul m d) (intMul y x))) s) (intMul (intAdd (intMul (intMul n e)
    (intMul x y)) (intMul (intMul m d) (intMul x y))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul n e)
    (intMul x y)) (intMul (intMul m y) (intMul x d))) s) (intMul (intAdd (intMul (intMul n e)
    (intMul x y)) (intMul (intMul m d) (intMul y x))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul n x)
    (intMul y e)) (intMul (intMul m y) (intMul x d))) s) (intMul (intAdd (intMul (intMul n e)
    (intMul x y)) (intMul (intMul m y) (intMul x d))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul n x)
    (intMul y e)) (intMul (intMul b e) (intMul x d))) s) (intMul (intAdd (intMul (intMul n x)
    (intMul y e)) (intMul (intMul m y) (intMul x d))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul a d)
    (intMul y e)) (intMul (intMul b e) (intMul x d))) s) (intMul (intAdd (intMul (intMul n x)
    (intMul y e)) (intMul (intMul b e) (intMul x d))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul a d)
    (intMul y e)) (intMul (intMul b x) (intMul d e))) s) (intMul (intAdd (intMul (intMul a d)
    (intMul y e)) (intMul (intMul b e) (intMul x d))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intAdd (intMul (intMul a y)
    (intMul d e)) (intMul (intMul b x) (intMul d e))) s) (intMul (intAdd (intMul (intMul a d)
    (intMul y e)) (intMul (intMul b x) (intMul d e))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intAdd (intMul a y)
    (intMul b x)) (intMul d e)) s) (intMul (intAdd (intMul (intMul a y) (intMul d e)) (intMul
    (intMul b x) (intMul d e))) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intAdd (intMul a y)
    (intMul b x)) s) (intMul d e)) (intMul (intMul (intAdd (intMul a y) (intMul b x)) (intMul d
    e)) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul r (intMul x y))
    (intMul d e)) (intMul (intMul (intAdd (intMul a y) (intMul b x)) s) (intMul d e))
  (ratEqMulFront (intMul x y) r (intMul d e))
  (cong0 Int Int (intMul r (intMul x y)) (intMul (intAdd (intMul a y) (intMul b x)) s) (fun qv
    => (intMul qv (intMul d e)))
  h0))
  (ratEqMulTail (intAdd (intMul a y) (intMul b x)) s (intMul d e)))
  (cong0 Int Int (intMul (intAdd (intMul a y) (intMul b x)) (intMul d e)) (intAdd (intMul
    (intMul a y) (intMul d e)) (intMul (intMul b x) (intMul d e))) (fun qv => (intMul qv s))
  (ratFieldIntAddMul (intMul a y) (intMul b x) (intMul d e))))
  (cong0 Int Int (intAdd (intMul (intMul a y) (intMul d e)) (intMul (intMul b x) (intMul d e)))
    (intAdd (intMul (intMul a d) (intMul y e)) (intMul (intMul b x) (intMul d e))) (fun qv =>
    (intMul qv s))
  (cong0 Int Int (intMul (intMul a y) (intMul d e)) (intMul (intMul a d) (intMul y e)) (fun qv
    => (intAdd qv (intMul (intMul b x) (intMul d e))))
  (ratFieldMulSwap a y d e))))
  (cong0 Int Int (intAdd (intMul (intMul a d) (intMul y e)) (intMul (intMul b x) (intMul d e)))
    (intAdd (intMul (intMul a d) (intMul y e)) (intMul (intMul b e) (intMul x d))) (fun qv =>
    (intMul qv s))
  (cong0 Int Int (intMul (intMul b x) (intMul d e)) (intMul (intMul b e) (intMul x d)) (fun qv
    => (intAdd (intMul (intMul a d) (intMul y e)) qv))
  (ratFieldMulRotate b x d e))))
  (cong0 Int Int (intAdd (intMul (intMul a d) (intMul y e)) (intMul (intMul b e) (intMul x d)))
    (intAdd (intMul (intMul n x) (intMul y e)) (intMul (intMul b e) (intMul x d))) (fun qv =>
    (intMul qv s))
  (cong0 Int Int (intMul (intMul a d) (intMul y e)) (intMul (intMul n x) (intMul y e)) (fun qv
    => (intAdd qv (intMul (intMul b e) (intMul x d))))
  (cong0 Int Int (intMul a d) (intMul n x) (fun qv => (intMul qv (intMul y e)))
  h1))))
  (cong0 Int Int (intAdd (intMul (intMul n x) (intMul y e)) (intMul (intMul b e) (intMul x d)))
    (intAdd (intMul (intMul n x) (intMul y e)) (intMul (intMul m y) (intMul x d))) (fun qv =>
    (intMul qv s))
  (cong0 Int Int (intMul (intMul b e) (intMul x d)) (intMul (intMul m y) (intMul x d)) (fun qv
    => (intAdd (intMul (intMul n x) (intMul y e)) qv))
  (cong0 Int Int (intMul b e) (intMul m y) (fun qv => (intMul qv (intMul x d)))
  h2))))
  (cong0 Int Int (intAdd (intMul (intMul n x) (intMul y e)) (intMul (intMul m y) (intMul x d)))
    (intAdd (intMul (intMul n e) (intMul x y)) (intMul (intMul m y) (intMul x d))) (fun qv =>
    (intMul qv s))
  (cong0 Int Int (intMul (intMul n x) (intMul y e)) (intMul (intMul n e) (intMul x y)) (fun qv
    => (intAdd qv (intMul (intMul m y) (intMul x d))))
  (ratFieldMulRotate n x y e))))
  (cong0 Int Int (intAdd (intMul (intMul n e) (intMul x y)) (intMul (intMul m y) (intMul x d)))
    (intAdd (intMul (intMul n e) (intMul x y)) (intMul (intMul m d) (intMul y x))) (fun qv =>
    (intMul qv s))
  (cong0 Int Int (intMul (intMul m y) (intMul x d)) (intMul (intMul m d) (intMul y x)) (fun qv
    => (intAdd (intMul (intMul n e) (intMul x y)) qv))
  (ratFieldMulRotate m y x d))))
  (cong0 Int Int (intAdd (intMul (intMul n e) (intMul x y)) (intMul (intMul m d) (intMul y x)))
    (intAdd (intMul (intMul n e) (intMul x y)) (intMul (intMul m d) (intMul x y))) (fun qv =>
    (intMul qv s))
  (cong0 Int Int (intMul (intMul m d) (intMul y x)) (intMul (intMul m d) (intMul x y)) (fun qv
    => (intAdd (intMul (intMul n e) (intMul x y)) qv))
  (cong0 Int Int (intMul y x) (intMul x y) (fun qv => (intMul (intMul m d) qv))
  (intMulComm y x)))))
  (cong0 Int Int (intAdd (intMul (intMul n e) (intMul x y)) (intMul (intMul m d) (intMul x y)))
    (intMul (intAdd (intMul n e) (intMul m d)) (intMul x y)) (fun qv => (intMul qv s))
  (sym0 Int (intMul (intAdd (intMul n e) (intMul m d)) (intMul x y)) (intAdd (intMul (intMul n
    e) (intMul x y)) (intMul (intMul m d) (intMul x y))) (ratFieldIntAddMul (intMul n e) (intMul
    m d) (intMul x y)))))
  (sym0 Int (intMul (intMul x y) (intMul (intAdd (intMul n e) (intMul m d)) s)) (intMul (intMul
    (intAdd (intMul n e) (intMul m d)) (intMul x y)) s) (ratEqMulFront (intMul x y) (intAdd
    (intMul n e) (intMul m d)) s)))

def ratFieldMulRepCore : (a : Int) -> (b : Int) -> (x : Int) -> (y : Int) ->
    (r : Int) -> (s : Int) -> (n : Int) -> (m : Int) -> (d : Int) -> (e : Int) ->
    (hk : Eq Int (intMul x y) intZero -> Empty) ->
    (0 h0 : Eq Int (intMul r (intMul x y)) (intMul (intMul a b) s)) ->
    (0 h1 : Eq Int (intMul a d) (intMul n x)) ->
    (0 h2 : Eq Int (intMul b e) (intMul m y)) -> Eq Int (intMul r (intMul d e)) (intMul (intMul
      n m) s) :=
  fun a b x y r s n m d e hk h0 h1 h2 => intMulCancelLeft (intMul x y) (intMul r (intMul d e))
    (intMul (intMul n m) s) hk
    (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intMul n m)
      (intMul x y)) s) (intMul (intMul x y) (intMul (intMul n m) s))
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intMul n x) (intMul
    m y)) s) (intMul (intMul (intMul n m) (intMul x y)) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intMul n x) (intMul
    b e)) s) (intMul (intMul (intMul n x) (intMul m y)) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intMul a d) (intMul
    b e)) s) (intMul (intMul (intMul n x) (intMul b e)) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intMul a b) (intMul
    d e)) s) (intMul (intMul (intMul a d) (intMul b e)) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul (intMul a b) s)
    (intMul d e)) (intMul (intMul (intMul a b) (intMul d e)) s)
  (trans0 Int (intMul (intMul x y) (intMul r (intMul d e))) (intMul (intMul r (intMul x y))
    (intMul d e)) (intMul (intMul (intMul a b) s) (intMul d e))
  (ratEqMulFront (intMul x y) r (intMul d e))
  (cong0 Int Int (intMul r (intMul x y)) (intMul (intMul a b) s) (fun qv => (intMul qv (intMul d
    e)))
  h0))
  (ratEqMulTail (intMul a b) s (intMul d e)))
  (cong0 Int Int (intMul (intMul a b) (intMul d e)) (intMul (intMul a d) (intMul b e)) (fun qv
    => (intMul qv s))
  (ratFieldMulSwap a b d e)))
  (cong0 Int Int (intMul (intMul a d) (intMul b e)) (intMul (intMul n x) (intMul b e)) (fun qv
    => (intMul qv s))
  (cong0 Int Int (intMul a d) (intMul n x) (fun qv => (intMul qv (intMul b e)))
  h1)))
  (cong0 Int Int (intMul (intMul n x) (intMul b e)) (intMul (intMul n x) (intMul m y)) (fun qv
    => (intMul qv s))
  (cong0 Int Int (intMul b e) (intMul m y) (fun qv => (intMul (intMul n x) qv))
  h2)))
  (cong0 Int Int (intMul (intMul n x) (intMul m y)) (intMul (intMul n m) (intMul x y)) (fun qv
    => (intMul qv s))
  (ratFieldMulSwap n x m y)))
  (sym0 Int (intMul (intMul x y) (intMul (intMul n m) s)) (intMul (intMul (intMul n m) (intMul x
    y)) s) (ratEqMulFront (intMul x y) (intMul n m) s)))

-- A representation remains valid when the input fractions are replaced
-- by any cross-equivalent numerator and denominator pair.
def ratAddRep : (a : Rat) -> (b : Rat) -> (n : Int) -> (m : Int) -> (d : Nat) -> (e : Nat) ->
    (0 ha : ratRep a n d) -> (0 hb : ratRep b m e) ->
    ratRep (ratAdd a b) (intAdd (intMul n (pos e)) (intMul m (pos d))) (mul d e) :=
  fun a b n m d e ha hb => ratFieldAddRepCore (ratNum a) (ratNum b) (pos (ratDen a)) (pos
    (ratDen b))
    (ratNum (ratAdd a b)) (pos (ratDen (ratAdd a b))) n m (pos d) (pos e)
    (fun h => ratDenMulNeZero a b (posInj (mul (ratDen a) (ratDen b)) zero h))
    (ratAddValue a b) ha hb

def ratMulRep : (a : Rat) -> (b : Rat) -> (n : Int) -> (m : Int) -> (d : Nat) -> (e : Nat) ->
    (0 ha : ratRep a n d) -> (0 hb : ratRep b m e) ->
    ratRep (ratMul a b) (intMul n m) (mul d e) :=
  fun a b n m d e ha hb => ratFieldMulRepCore (ratNum a) (ratNum b) (pos (ratDen a)) (pos
    (ratDen b))
    (ratNum (ratMul a b)) (pos (ratDen (ratMul a b))) n m (pos d) (pos e)
    (fun h => ratDenMulNeZero a b (posInj (mul (ratDen a) (ratDen b)) zero h))
    (ratMulValue a b) ha hb

def ratFieldNatMulNeZero : (a : Nat) -> (b : Nat) -> (ha : Eq Nat a zero -> Empty) ->
    (hb : Eq Nat b zero -> Empty) -> Eq Nat (mul a b) zero -> Empty :=
  fun a b ha hb h => hb (natMulEqZeroRight a b ha h)

def ratRepZero : (d : Nat) -> ratRep ratZero intZero d :=
  fun d => trans0 Int (intMul intZero (pos d)) intZero (intMul intZero intOne)
    (intMulZeroLeft (pos d)) (sym0 Int (intMul intZero intOne) intZero (intMulZeroLeft intOne))

def ratRepCast : (r : Rat) -> (n : Int) -> (m : Int) -> (d : Nat) -> (e : Nat) ->
    (0 hn : Eq Int n m) -> (0 hd : Eq Nat d e) -> ratRep r n d -> ratRep r m e :=
  fun r n m d e hn hd h => subst0 Nat d e (fun z => ratRep r m z) hd
    (subst0 Int n m (fun z => ratRep r z d) hn h)

def ratFieldScaleCore : (a : Int) -> (b : Int) -> (c : Int) -> (d : Int) -> (k : Int) ->
    (0 h : Eq Int (intMul a d) (intMul b c)) ->
    Eq Int (intMul a (intMul d k)) (intMul (intMul b k) c) :=
  fun a b c d k h => (trans0 Int (intMul a (intMul d k)) (intMul (intMul b c) k) (intMul (intMul
    b k) c)
  (trans0 Int (intMul a (intMul d k)) (intMul (intMul a d) k) (intMul (intMul b c) k)
  (sym0 Int (intMul (intMul a d) k) (intMul a (intMul d k)) (intMulAssoc a d k))
  (cong0 Int Int (intMul a d) (intMul b c) (fun qv => (intMul qv k))
  h))
  (trans0 Int (intMul (intMul b c) k) (intMul b (intMul c k)) (intMul (intMul b k) c)
  (intMulAssoc b c k)
  (sym0 Int (intMul (intMul b k) c) (intMul b (intMul c k)) (trans0 Int (intMul (intMul b k) c)
    (intMul b (intMul k c)) (intMul b (intMul c k))
  (intMulAssoc b k c)
  (cong0 Int Int (intMul k c) (intMul c k) (fun qv => (intMul b qv))
  (intMulComm k c))))))

def ratRepScale : (r : Rat) -> (n : Int) -> (d : Nat) -> (k : Nat) ->
    (0 h : ratRep r n d) -> ratRep r (intMul n (pos k)) (mul d k) :=
  fun r n d k h => ratFieldScaleCore (ratNum r) n (pos (ratDen r)) (pos d) (pos k) h

def ratFieldNatOneMul : (a : Nat) -> Eq Nat (mul one a) a :=
  fun a => trans0 Nat (mul one a) (mul a one) a (mulComm one a) (mulOne a)

