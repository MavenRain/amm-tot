-- The axioms of an ordered field, bundled into one record.
-- The record states, once, the fourteen Mathlib facts that the derivation
-- library reads. In Lean these facts arrive from instance resolution on
-- Field F, LinearOrder F and IsStrictOrderedRing F. tot has no classes and
-- no instances, so the facts are the fields of one hypothesis record.
-- Mathlib sources, in field order: add_comm, add_assoc, add_zero,
-- add_neg_cancel, mul_comm, mul_assoc, mul_one, mul_add, sub_eq_add_neg,
-- div_eq_mul_inv, mul_inv_cancel, lt_irrefl, lt_trans, add_lt_add_left.
-- The ten parameters carry the 0 marker, because a data type parameter must
-- carry that marker. The fourteen constructor fields carry quantity w,
-- because a def projects each one into a w position, and a 0 field fails on
-- projection with an erased-variable-used-at-runtime error.
-- The record has no projections. A def that needs a field destructures the
-- record with one match.
-- No inhabitant of OrderedField is supplied here. Every theorem that reads
-- the record stays conditional on it.
data OrderedField (0 F : Type 0) (0 fadd : F -> F -> F) (0 fmul : F -> F -> F)
    (0 fsub : F -> F -> F) (0 fdiv : F -> F -> F) (0 fneg : F -> F)
    (0 finv : F -> F) (0 fzero : F) (0 fone : F)
    (0 flt : F -> F -> Type 0) : Type 0 :=
  | orderedField :
    (addComm : (a : F) -> (b : F) -> Eq F (fadd a b) (fadd b a)) ->
    (addAssoc : (a : F) -> (b : F) -> (c : F) -> Eq F (fadd (fadd a b) c) (fadd a (fadd b c))) ->
    (addZero : (a : F) -> Eq F (fadd a fzero) a) ->
    (addNegCancel : (a : F) -> Eq F (fadd a (fneg a)) fzero) ->
    (mulComm : (a : F) -> (b : F) -> Eq F (fmul a b) (fmul b a)) ->
    (mulAssoc : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul (fmul a b) c) (fmul a (fmul b c))) ->
    (mulOne : (a : F) -> Eq F (fmul a fone) a) ->
    (mulAdd : (a : F) -> (b : F) -> (c : F) -> Eq F (fmul a (fadd b c)) (fadd (fmul a b) (fmul a c))) ->
    (subEqAddNeg : (a : F) -> (b : F) -> Eq F (fsub a b) (fadd a (fneg b))) ->
    (divEqMulInv : (a : F) -> (b : F) -> Eq F (fdiv a b) (fmul a (finv b))) ->
    (mulInvCancel : (a : F) -> (0 hne : (0 e : Eq F a fzero) -> Empty) -> Eq F (fmul a (finv a)) fone) ->
    (ltIrrefl : (a : F) -> (0 h : flt a a) -> Empty) ->
    (ltTrans : (a : F) -> (b : F) -> (c : F) -> (0 h1 : flt a b) -> (0 h2 : flt b c) -> flt a c) ->
    (addLtAddLeft : (a : F) -> (b : F) -> (c : F) -> (0 h : flt b c) -> flt (fadd a b) (fadd a c)) ->
    OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt
