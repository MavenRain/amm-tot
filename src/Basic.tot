-- The definitions and the structural theorems of AmmLean/Basic.lean.
-- Every pure def is a reducible def over the ten operation parameters
-- (OPS) and never takes the axiom record A, because no pure definition
-- needs an axiom.
-- Every body reads the pool and the fee rate through the projections of
-- src/Pool.tot and never matches on the variable, because a match on a
-- variable pool is stuck and would block every later unfolding.
-- The let bindings of Basic.lean (dy, ein, mintedLP, dxOut and dyOut)
-- are inlined.
-- Part 0 holds the nine pure definitions. effectivePrice cites
-- swapOutput, effectiveInput cites feeComplement, and swapOutputWithFee
-- cites effectiveInput, so the order is forced.

reducible def constantProduct :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (p : Pool F fzero flt) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt p =>
    fmul (poolReserveX F fzero flt p) (poolReserveY F fzero flt p)

check constantProduct

reducible def swapOutput :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (p : Pool F fzero flt) -> (dx : F) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt p dx =>
    fdiv (fmul (poolReserveY F fzero flt p) dx) (fadd (poolReserveX F fzero flt p) dx)

check swapOutput

reducible def effectivePrice :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (p : Pool F fzero flt) -> (dx : F) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt p dx =>
    fdiv (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx) dx

check effectivePrice

reducible def spotPrice :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (p : Pool F fzero flt) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt p =>
    fdiv (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)

check spotPrice

reducible def feeComplement :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (f : FeeRate F fzero fone flt) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt f =>
    fsub fone (feeRateRate F fzero fone flt f)

check feeComplement

reducible def effectiveInput :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (dx : F) -> (f : FeeRate F fzero fone flt) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt dx f =>
    fmul dx (feeComplement F fadd fmul fsub fdiv fneg finv fzero fone flt f)

check effectiveInput

reducible def swapOutputWithFee :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (p : Pool F fzero flt) -> (dx : F) -> (f : FeeRate F fzero fone flt) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt p dx f =>
    fdiv (fmul (poolReserveY F fzero flt p) (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)) (fadd (poolReserveX F fzero flt p) (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))

check swapOutputWithFee

reducible def redeemX :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (p : Pool F fzero flt) -> (lp : F) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt p lp =>
    fdiv (fmul lp (poolReserveX F fzero flt p)) (poolTotalLP F fzero flt p)

check redeemX

reducible def redeemY :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (p : Pool F fzero flt) -> (lp : F) -> F :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt p lp =>
    fdiv (fmul lp (poolReserveY F fzero flt p)) (poolTotalLP F fzero flt p)

check redeemY

def constantProductPos :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) ->
  flt fzero (constantProduct F fadd fmul fsub fdiv fneg finv fzero fone flt p) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      mulPos (poolReserveX F fzero flt p) (poolReserveY F fzero flt p)
        (poolHx F fzero flt p) (poolHy F fzero flt p)
    end

check constantProductPos

def poolReserveXNeZero :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) ->
  (0 e : Eq F (poolReserveX F fzero flt p) fzero) -> Empty :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p =>
    deriveNeOfGt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (poolReserveX F fzero flt p) (poolHx F fzero flt p)

check poolReserveXNeZero

def poolReserveYNeZero :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) ->
  (0 e : Eq F (poolReserveY F fzero flt p) fzero) -> Empty :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p =>
    deriveNeOfGt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (poolReserveY F fzero flt p) (poolHy F fzero flt p)

check poolReserveYNeZero

def poolTotalLPNeZero :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) ->
  (0 e : Eq F (poolTotalLP F fzero flt p) fzero) -> Empty :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p =>
    deriveNeOfGt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (poolTotalLP F fzero flt p) (poolHlp F fzero flt p)

check poolTotalLPNeZero

def reserveXAddPos :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero (fadd (poolReserveX F fzero flt p) dx) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    deriveAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (poolReserveX F fzero flt p) dx (poolHx F fzero flt p) hdx

check reserveXAddPos

def reserveXAddNeZero :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  (0 e : Eq F (fadd (poolReserveX F fzero flt p) dx) fzero) -> Empty :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    deriveNeOfGt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (fadd (poolReserveX F fzero flt p) dx)
      (reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)

check reserveXAddNeZero

def feeComplementPos :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (f : FeeRate F fzero fone flt) -> flt fzero (feeComplement F fadd fmul fsub fdiv fneg finv fzero fone flt f) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A f =>
    subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      fone
      (feeRateRate F fzero fone flt f)
      (feeRateHlt F fzero fone flt f)

check feeComplementPos

def feeComplementLtOne :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (f : FeeRate F fzero fone flt) -> flt (feeComplement F fadd fmul fsub fdiv fneg finv fzero fone flt f) fone :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A f =>
    subLtSelf F fadd fmul fsub fdiv fneg finv fzero fone flt A
      fone
      (feeRateRate F fzero fone flt f)
      (feeRateHpos F fzero fone flt f)

check feeComplementLtOne

def swapHx :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero (fadd (poolReserveX F fzero flt p) dx) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx

check swapHx

def swapHy :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero
    (fsub (poolReserveY F fzero flt p)
      (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (poolReserveY F fzero flt p)
        (fdiv (fmul (poolReserveY F fzero flt p) dx)
          (fadd (poolReserveX F fzero flt p) dx))
        (divLtOfLtMul F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (fmul (poolReserveY F fzero flt p) dx)
          (poolReserveY F fzero flt p)
          (fadd (poolReserveX F fzero flt p) dx)
          (reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
          (subst0 F
            (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
              (fmul (poolReserveY F fzero flt p) dx))
            (fmul (poolReserveY F fzero flt p)
              (fadd (poolReserveX F fzero flt p) dx))
            (fun z => flt (fmul (poolReserveY F fzero flt p) dx) z)
            (sym0 F
              (fmul (poolReserveY F fzero flt p)
                (fadd (poolReserveX F fzero flt p) dx))
              (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
                (fmul (poolReserveY F fzero flt p) dx))
              (mulAdd (poolReserveY F fzero flt p) (poolReserveX F fzero flt p) dx))
            (ltAddOfPosLeft F fadd fmul fsub fdiv fneg finv fzero fone flt A
              (fmul (poolReserveY F fzero flt p) dx)
              (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
              (mulPos (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)
                (poolHy F fzero flt p) (poolHx F fzero flt p)))))
    end

check swapHy

def swapWithFeeHx :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  (f : FeeRate F fzero fone flt) ->
  flt fzero (fadd (poolReserveX F fzero flt p) dx) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f =>
    reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx

check swapWithFeeHx

def swapWithFeeHy :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  (f : FeeRate F fzero fone flt) ->
  flt fzero (fsub (poolReserveY F fzero flt p)
    (swapOutputWithFee F fadd fmul fsub fdiv fneg finv fzero fone flt p dx f)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (poolReserveY F fzero flt p)
        (fdiv (fmul (poolReserveY F fzero flt p)
                (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))
              (fadd (poolReserveX F fzero flt p)
                (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
        (divLtOfLtMul F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (fmul (poolReserveY F fzero flt p)
            (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))
          (poolReserveY F fzero flt p)
          (fadd (poolReserveX F fzero flt p)
            (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))
          (deriveAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A
            (poolReserveX F fzero flt p)
            (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)
            (poolHx F fzero flt p)
            (mulPos dx (feeComplement F fadd fmul fsub fdiv fneg finv fzero fone flt f)
              hdx
              (feeComplementPos F fadd fmul fsub fdiv fneg finv fzero fone flt A f)))
          (subst0 F
            (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
                  (fmul (poolReserveY F fzero flt p)
                    (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
            (fmul (poolReserveY F fzero flt p)
              (fadd (poolReserveX F fzero flt p)
                (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
            (fun z => flt (fmul (poolReserveY F fzero flt p)
                            (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)) z)
            (sym0 F
              (fmul (poolReserveY F fzero flt p)
                (fadd (poolReserveX F fzero flt p)
                  (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
              (fadd (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
                    (fmul (poolReserveY F fzero flt p)
                      (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
              (mulAdd (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)
                (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f)))
            (ltAddOfPosLeft F fadd fmul fsub fdiv fneg finv fzero fone flt A
              (fmul (poolReserveY F fzero flt p)
                (effectiveInput F fadd fmul fsub fdiv fneg finv fzero fone flt dx f))
              (fmul (poolReserveY F fzero flt p) (poolReserveX F fzero flt p))
              (mulPos (poolReserveY F fzero flt p) (poolReserveX F fzero flt p)
                (poolHy F fzero flt p) (poolHx F fzero flt p)))))
    end

check swapWithFeeHy

def addLiquidityHx :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero (fadd (poolReserveX F fzero flt p) dx) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    reserveXAddPos F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx

check addLiquidityHx

def addLiquidityHy :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero
    (fadd (poolReserveY F fzero flt p)
      (fdiv (fmul dx (poolReserveY F fzero flt p)) (poolReserveX F fzero flt p))) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      ltOfLtOfLe F fadd fmul fsub fdiv fneg finv fzero fone flt A
        fzero
        (poolReserveY F fzero flt p)
        (fadd (poolReserveY F fzero flt p)
          (fdiv (fmul dx (poolReserveY F fzero flt p)) (poolReserveX F fzero flt p)))
        (poolHy F fzero flt p)
        (leAddOfNonnegRight F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (poolReserveY F fzero flt p)
          (fdiv (fmul dx (poolReserveY F fzero flt p)) (poolReserveX F fzero flt p))
          (leOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
            fzero
            (fdiv (fmul dx (poolReserveY F fzero flt p)) (poolReserveX F fzero flt p))
            (divPos F fadd fmul fsub fdiv fneg finv fzero fone flt A
              (fmul dx (poolReserveY F fzero flt p))
              (poolReserveX F fzero flt p)
              (mulPos dx (poolReserveY F fzero flt p) hdx (poolHy F fzero flt p))
              (poolHx F fzero flt p))))
    end

check addLiquidityHy

def addLiquidityHlp :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  flt fzero
    (fadd (poolTotalLP F fzero flt p)
      (fdiv (fmul dx (poolTotalLP F fzero flt p)) (poolReserveX F fzero flt p))) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      ltOfLtOfLe F fadd fmul fsub fdiv fneg finv fzero fone flt A
        fzero
        (poolTotalLP F fzero flt p)
        (fadd (poolTotalLP F fzero flt p)
          (fdiv (fmul dx (poolTotalLP F fzero flt p)) (poolReserveX F fzero flt p)))
        (poolHlp F fzero flt p)
        (leAddOfNonnegRight F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (poolTotalLP F fzero flt p)
          (fdiv (fmul dx (poolTotalLP F fzero flt p)) (poolReserveX F fzero flt p))
          (leOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
            fzero
            (fdiv (fmul dx (poolTotalLP F fzero flt p)) (poolReserveX F fzero flt p))
            (divPos F fadd fmul fsub fdiv fneg finv fzero fone flt A
              (fmul dx (poolTotalLP F fzero flt p))
              (poolReserveX F fzero flt p)
              (mulPos dx (poolTotalLP F fzero flt p) hdx (poolHlp F fzero flt p))
              (poolHx F fzero flt p))))
    end

check addLiquidityHlp

def removeLiquidityHx :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (lp : F) ->
  (hlpPos : flt fzero lp) ->
  (hlpLt : flt lp (poolTotalLP F fzero flt p)) ->
  flt fzero (fsub (poolReserveX F fzero flt p)
    (redeemX F fadd fmul fsub fdiv fneg finv fzero fone flt p lp)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p lp hlpPos hlpLt =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (poolReserveX F fzero flt p)
        (fdiv (fmul lp (poolReserveX F fzero flt p)) (poolTotalLP F fzero flt p))
        (divLtOfLtMul F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (fmul lp (poolReserveX F fzero flt p))
          (poolReserveX F fzero flt p)
          (poolTotalLP F fzero flt p)
          (poolHlp F fzero flt p)
          (subst0 F
            (fmul (poolTotalLP F fzero flt p) (poolReserveX F fzero flt p))
            (fmul (poolReserveX F fzero flt p) (poolTotalLP F fzero flt p))
            (fun z => flt (fmul lp (poolReserveX F fzero flt p)) z)
            (mulComm (poolTotalLP F fzero flt p) (poolReserveX F fzero flt p))
            (mulLtMulOfPosRight F fadd fmul fsub fdiv fneg finv fzero fone flt A
              lp
              (poolTotalLP F fzero flt p)
              (poolReserveX F fzero flt p)
              hlpLt
              (poolHx F fzero flt p))))
    end

check removeLiquidityHx

def removeLiquidityHy :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (lp : F) ->
  (hlpPos : flt fzero lp) ->
  (hlpLt : flt lp (poolTotalLP F fzero flt p)) ->
  flt fzero (fsub (poolReserveY F fzero flt p)
    (redeemY F fadd fmul fsub fdiv fneg finv fzero fone flt p lp)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p lp hlpPos hlpLt =>
    match A with
    | orderedField addComm addAssoc addZero addNegCancel mulComm mulAssoc mulOne mulAdd subEqAddNeg divEqMulInv mulInvCancel ltIrrefl ltTrans addLtAddLeft mulPos ltTrichotomy zeroNeOne =>
      subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
        (poolReserveY F fzero flt p)
        (fdiv (fmul lp (poolReserveY F fzero flt p)) (poolTotalLP F fzero flt p))
        (divLtOfLtMul F fadd fmul fsub fdiv fneg finv fzero fone flt A
          (fmul lp (poolReserveY F fzero flt p))
          (poolReserveY F fzero flt p)
          (poolTotalLP F fzero flt p)
          (poolHlp F fzero flt p)
          (subst0 F
            (fmul (poolTotalLP F fzero flt p) (poolReserveY F fzero flt p))
            (fmul (poolReserveY F fzero flt p) (poolTotalLP F fzero flt p))
            (fun z => flt (fmul lp (poolReserveY F fzero flt p)) z)
            (mulComm (poolTotalLP F fzero flt p) (poolReserveY F fzero flt p))
            (mulLtMulOfPosRight F fadd fmul fsub fdiv fneg finv fzero fone flt A
              lp
              (poolTotalLP F fzero flt p)
              (poolReserveY F fzero flt p)
              hlpLt
              (poolHy F fzero flt p))))
