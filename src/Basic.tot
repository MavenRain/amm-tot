check removeLiquidityHy

def removeLiquidityHlp :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (lp : F) ->
  (hlpPos : flt fzero lp) ->
  (hlpLt : flt lp (poolTotalLP F fzero flt p)) ->
  flt fzero (fsub (poolTotalLP F fzero flt p) lp) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p lp hlpPos hlpLt =>
    subPosOfLt F fadd fmul fsub fdiv fneg finv fzero fone flt A
      (poolTotalLP F fzero flt p)
      lp
      hlpLt

check removeLiquidityHlp

reducible def swap :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  Pool F fzero flt :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    pool F fzero flt
      (fadd (poolReserveX F fzero flt p) dx)
      (fsub (poolReserveY F fzero flt p)
        (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx))
      (poolTotalLP F fzero flt p)
      (swapHx F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
      (swapHy F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
      (poolHlp F fzero flt p)

check swap

reducible def swapWithFee :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  (f : FeeRate F fzero fone flt) ->
  Pool F fzero flt :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f =>
    pool F fzero flt
      (fadd (poolReserveX F fzero flt p) dx)
      (fsub (poolReserveY F fzero flt p)
        (swapOutputWithFee F fadd fmul fsub fdiv fneg finv fzero fone flt p dx f))
      (poolTotalLP F fzero flt p)
      (swapWithFeeHx F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f)
      (swapWithFeeHy F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx f)
      (poolHlp F fzero flt p)

check swapWithFee

reducible def addLiquidity :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  Pool F fzero flt :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    pool F fzero flt
      (fadd (poolReserveX F fzero flt p) dx)
      (fadd (poolReserveY F fzero flt p)
        (fdiv (fmul dx (poolReserveY F fzero flt p)) (poolReserveX F fzero flt p)))
      (fadd (poolTotalLP F fzero flt p)
        (fdiv (fmul dx (poolTotalLP F fzero flt p)) (poolReserveX F fzero flt p)))
      (addLiquidityHx F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
      (addLiquidityHy F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)
      (addLiquidityHlp F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx)

check addLiquidity

reducible def removeLiquidity :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (lp : F) ->
  (hlpPos : flt fzero lp) ->
  (hlpLt : flt lp (poolTotalLP F fzero flt p)) ->
  Pool F fzero flt :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p lp hlpPos hlpLt =>
    pool F fzero flt
      (fsub (poolReserveX F fzero flt p)
        (redeemX F fadd fmul fsub fdiv fneg finv fzero fone flt p lp))
      (fsub (poolReserveY F fzero flt p)
        (redeemY F fadd fmul fsub fdiv fneg finv fzero fone flt p lp))
      (fsub (poolTotalLP F fzero flt p) lp)
      (removeLiquidityHx F fadd fmul fsub fdiv fneg finv fzero fone flt A p lp hlpPos hlpLt)
      (removeLiquidityHy F fadd fmul fsub fdiv fneg finv fzero fone flt A p lp hlpPos hlpLt)
      (removeLiquidityHlp F fadd fmul fsub fdiv fneg finv fzero fone flt A p lp hlpPos hlpLt)

check removeLiquidity

def swapReserveX :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  Eq F
    (poolReserveX F fzero flt
      (swap F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))
    (fadd (poolReserveX F fzero flt p) dx) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    refl F (fadd (poolReserveX F fzero flt p) dx)

check swapReserveX

def swapReserveY :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  Eq F
    (poolReserveY F fzero flt
      (swap F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))
    (fsub (poolReserveY F fzero flt p)
      (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx)) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    refl F
      (fsub (poolReserveY F fzero flt p)
        (swapOutput F fadd fmul fsub fdiv fneg finv fzero fone flt p dx))

check swapReserveY

def swapTotalLP :
  (0 F : Type 0) ->
  (fadd : F -> F -> F) -> (fmul : F -> F -> F) -> (fsub : F -> F -> F) -> (fdiv : F -> F -> F) ->
  (fneg : F -> F) -> (finv : F -> F) -> (fzero : F) -> (fone : F) -> (0 flt : F -> F -> Type 0) ->
  (A : OrderedField F fadd fmul fsub fdiv fneg finv fzero fone flt) ->
  (p : Pool F fzero flt) -> (dx : F) -> (hdx : flt fzero dx) ->
  Eq F
    (poolTotalLP F fzero flt
      (swap F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx))
    (poolTotalLP F fzero flt p) :=
  fun F fadd fmul fsub fdiv fneg finv fzero fone flt A p dx hdx =>
    refl F (poolTotalLP F fzero flt p)

check swapTotalLP
